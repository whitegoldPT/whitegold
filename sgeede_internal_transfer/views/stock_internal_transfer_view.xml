<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE VIEW -->
    <record id="stock_internal_transfer_tree" model="ir.ui.view">
        <field name="name">stock.internal.transfer.tree</field>
        <field name="model">stock.internal.transfer</field>
        <field name="arch" type="xml">
            <tree string="Stock Internal Transfer" duplicate="0">
                <field name="name"/>
                <field name="date"/>
                <field name="source_warehouse_id"/>
                <field name="dest_warehouse_id"/>
                <field name="source_document"/>
                <field name="backorder_id" optional="hide"/>
                <field name="company_id"/>
                <field name="state" widget="badge" decoration-muted="state == 'draft'" decoration-info="state == 'send'" decoration-success="state in ('receive','done')" decoration-warning="state == 'partial_receive'" decoration-danger="state == 'cancel'"/>
                <field name="has_transit_products" invisible="1" optional="hide"/>
                <field name="partial_receive_reason" invisible="1" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="stock_internal_transfer_form" model="ir.ui.view">
        <field name="name">stock.internal.transfer.form</field>
        <field name="model">stock.internal.transfer</field>
        <field name="arch" type="xml">
            <form string="Stock Internal Transfer" delete="0" duplicate="0">
                <header>
                    <!-- Cancel -->
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-secondary"
                            invisible="not (state in ('draft'))"
                            groups="purchase.group_purchase_manager"/>

                    <!-- Set to Draft -->
                    <button name="action_draft" type="object" string="Set to Draft"
                            class="btn-secondary"
                            invisible="state != 'cancel'"/>

                    <!-- Return to Sender -->
                    <button name="action_return_to_sender" type="object" string="Return to Sender"
                            class="btn-warning"
                            invisible="(not has_transit_products) or (state != 'partial_receive')"
                            groups="stock.group_stock_manager"/>

                    <!-- SEND -->
                    <button name="do_enter_wizard" type="object" string="Send"
                            class="btn-primary"
                            invisible="(state != 'draft') or (not show_send_button)"/>

                    <!-- RECEIVE -->
                    <button name="do_enter_wizard" type="object" string="Receive"
                            class="btn-primary"
                            invisible="(state not in ('send','partial_receive')) or (not show_receive_button)"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,send,partial_receive,receive,cancel"/>
                </header>

                <sheet>
                    <field name="has_transit_products" invisible="1"/>
                    <field name="show_send_button" invisible="1"/>
                    <field name="show_receive_button" invisible="1"/>
                    <field name="has_requisition" invisible="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" icon="fa-file-text-o"
                                name="action_open_requisition"
                                invisible="not has_requisition"
                                string="Requisition" help="Open Purchase Requisition" style="min-height: 60px;"/>
                    </div>

                    <h1>
                        <field name="name" required="1" placeholder="Reference"
                               readonly="1"/>
                    </h1>

                    <group>
                        <field name="date" required="1" readonly="state != 'draft'"/>
                    </group>

                    <group col="4">
                        <field name="source_warehouse_id" required="1" readonly="state != 'draft'"/>
                        <field name="dest_warehouse_id" required="1" readonly="state != 'draft'"/>
                        <field name="company_id" readonly="state != 'draft'"/>
                    </group>

                    <group col="4">
                        <field name="backorder_id" readonly="1" invisible="not backorder_id"/>
                        <field name="return_transfer_id" readonly="1" invisible="not return_transfer_id"/>
                        <field name="source_document" readonly="1" placeholder="Source document reference" invisible="not source_document"/>
                    </group>

                    <group col="2" invisible="state not in ('partial_receive','receive','done')">
                        <field name="partial_receive_reason" readonly="1" nolabel="1"/>
                    </group>

                    <notebook>
                        <!-- PLANNED PRODUCTS -->
                        <page string="Planned Products" name="products">
                            <div class="alert alert-info" role="alert" invisible="not show_send_button">
                                <strong>Note:</strong> Only users assigned to the Source Warehouse can edit products.
                            </div>

                            <field name="line_ids" context="{'default_state': 'draft'}"
                                   readonly="(state != 'draft') or (not show_send_button)">
                                <tree editable="bottom">
                                    <field name="product_id" domain="[('type','!=','service')]" required="1"/>
                                    <field name="product_qty" string="Line Qty" required="1" column_invisible="parent.state != 'draft'"/>
                                    <field name="total_planned_qty" string="Planned Qty" readonly="1"/>
                                    <field name="qty_available" string="Available in Source" readonly="1"/>
                                    <field name="qty_sent" string="Sent to Transit" readonly="1"/>
                                    <field name="qty_received" string="Received" readonly="1"/>
                                    <field name="qty_in_transit" string="In Transit" readonly="1"/>
                                    <field name="product_uom_id" required="1"/>
                                    <!-- ADDED: Second UOM fields -->
                                    <field name="second_uom" string="Second UOM"
                                           force_save="1"
                                           optional="show"
                                           readonly="not need_second_uom"
                                           groups="uom.group_uom"/>
                                    <field name="need_second_uom" column_invisible="1"/>
                                    <field name="lot_id" optional="show"/>
                                </tree>
                                <form>
                                            <field name="product_id" domain="[('type','!=','service')]" required="1"/>
                                            <field name="product_qty" required="1"/>
                                            <field name="product_uom_id" required="1"/>
                                            <!-- ADDED: Second UOM fields in form view -->
                                            <field name="need_second_uom" column_invisible="1"/>
                                            <field name="second_uom" string="Second UOM"
                                                       force_save="1"
                                                       groups="uom.group_uom"
                                                       optional="show"
                                                       readonly="not need_second_uom"/>
                                            <field name="lot_id"/>
                                            <field name="qty_available" string="Available in Source" readonly="1"/>
                                            <field name="qty_sent" string="Sent to Transit" readonly="1"/>
                                            <field name="qty_received" string="Received" readonly="1"/>
                                            <field name="qty_in_transit" string="In Transit" readonly="1"/>
                                            <field name="total_planned_qty" string="Planned Qty" readonly="1"/>
                                </form>
                            </field>
                        </page>

                        <!-- TRANSIT PRODUCTS -->
                        <page string="Stock in Transit" name="transit" invisible="not has_transit_products">
                            <div class="alert alert-info" role="alert">
                                <strong>Actual products in transit location:</strong> Based on completed delivery orders.
                            </div>

                            <field name="transit_product_ids" readonly="1">
                                <tree>
                                    <field name="product_id"/>
                                    <field name="product_qty" string="Qty in Transit"/>
                                    <field name="product_uom_id"/>
                                    <field name="second_uom" string="Second UOM"
                                           force_save="1"
                                           groups="uom.group_uom"
                                           optional="show"
                                           readonly="not need_second_uom"/>
                                    <field name="need_second_uom" column_invisible="1"/>
                                    <field name="lot_id"/>
                                    <field name="send_picking_id" widget="many2one" options="{'no_open': True}"/>
                                </tree>
                            </field>

                            <div class="alert alert-warning mt-4" role="alert"
                                 invisible="state != 'partial_receive'">
                                <strong>Note:</strong> Click "Receive" to get remaining products.
                                Click "Return to Sender" to send items back.
                            </div>
                        </page>

                        <!-- PICKINGS -->
                        <page string="Pickings" name="pickings">
                            <field name="picking_ids" readonly="1" context="{'create': False}">
                                <tree>
                                    <field name="name"/>
                                    <field name="origin"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="state"/>
                                    <field name="date_done"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_stock_internal_transfer" model="ir.actions.act_window">
        <field name="name">Stock Internal Transfer</field>
        <field name="res_model">stock.internal.transfer</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU -->
    <menuitem action="action_stock_internal_transfer"
              id="menu_stock_internal_transfer"
              parent="stock.menu_stock_warehouse_mgmt"
              sequence="1"/>
</odoo>