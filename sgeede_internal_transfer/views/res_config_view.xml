<odoo>
    <!-- Option 1: Add to existing Stock app -->
    <record id="view_res_config_settings_form_stock" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.stock</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Internal Transfer Configuration">
                    <setting>
                        <field name="transit_location_id" required="1" domain="[('usage', '=', 'transit')]"/>
                        <div class="text-muted">
                            Configure the transit location for internal transfers between warehouses
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>