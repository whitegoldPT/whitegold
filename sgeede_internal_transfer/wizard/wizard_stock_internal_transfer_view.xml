<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_stock_internal_transfer_view" model="ir.ui.view">
        <field name="name">Enter Transfer Details</field>
        <field name="model">wizard.stock.internal.transfer</field>
        <field name="arch" type="xml">
            <form string="Transfer Details">

                <!-- Add the field so it can be used in modifiers -->
                <field name="is_return_to_sender" invisible="1"/>

                
                <div class="o_horizontal_separator text-uppercase fw-bolder big-title mb-3">
                    Products To Move
                </div>

                <!-- Notes at the top with full width -->
                <div style="display: flex; flex-direction: column; gap: 12px; width: 100%; margin-bottom: 16px;">
                    <div class="alert alert-info p-3" role="alert" groups="stock.group_tracking_lot" style="display: block; width: 100%; background-color: #e7f3ff; border-left: 4px solid #17a2b8; border-radius: 4px; clear: both;">
                        <i class="fa fa-info-circle mr-2" style="color: #17a2b8; vertical-align: middle;"/>
                        <span style="color: #0c5460; font-size: 13px; line-height: 1.5;">Setting a product and a source package means that the product will be taken out of the package.</span>
                    </div>
                    <div class="alert alert-warning p-3" role="alert" style="display: block; width: 100%; background-color: #fff3cd; border-left: 4px solid #ffc107; border-radius: 4px; clear: both;">
                        <i class="fa fa-exclamation-triangle mr-2" style="color: #856404; vertical-align: middle;"/>
                        <strong style="color: #856404; font-weight: 600; margin-left: 4px;">Note:</strong>
                        <span style="color: #856404; font-size: 13px; line-height: 1.5; margin-left: 4px;">Setting quantity to 0 or removing a line will delete it from the transfer.</span>
                    </div>
                    <!-- Python-style invisible modifiers -->
                    <div class="alert alert-info p-3" role="alert" invisible="is_return_to_sender" style="display: block; width: 100%; background-color: #d1ecf1; border-left: 4px solid #0c5460; border-radius: 4px; clear: both;">
                        <i class="fa fa-info-circle mr-2" style="color: #0c5460; vertical-align: middle;"/>
                        <span style="color: #0c5460; font-size: 13px; line-height: 1.5; margin-left: 4px;">You can adjust the quantities below, but cannot exceed the original transferred quantities.</span>
                    </div>
                    <div class="alert alert-warning p-3" role="alert" invisible="not is_return_to_sender" style="display: block; width: 100%; background-color: #fff3cd; border-left: 4px solid #ff9800; border-radius: 4px; clear: both;">
                        <i class="fa fa-undo mr-2" style="color: #e65100; vertical-align: middle;"/>
                        <strong style="color: #e65100; font-weight: 600;">Return to Sender:</strong>
                        <span style="color: #e65100; font-size: 13px; line-height: 1.5; margin-left: 4px;">Adjust quantities to return products from transit back to sender warehouse.</span>
                    </div>
                </div>

                <group>
                    <field name="item_ids">
                        <tree string="Inventory Details" editable="bottom" delete="1">
                            <field name="product_id" required="1"/>
                            <field name="product_qty" required="1"/>
                            <field name="qty_available" string="Available in Source" readonly="1"/>
                            <field name="qty_in_transit" string="Available in Transit" readonly="1"
                                   invisible="qty_in_transit == 0"/>
                            <field name="product_uom_id" options="{'no_open': True}" readonly="1"/>
                            <!-- ADDED: Second UOM fields in wizard tree -->
                            <field name="need_second_uom" invisible="1"/>
<!--                            <field name="second_uom" string="Second UOM"-->
<!--                                   attrs="{'invisible': [('need_second_uom', '=', False)]}"/>-->
                            <field name="second_uom" string="Second UOM"/>
                            <field name="source_location_id" required="1" readonly="1"/>
                            <field name="dest_location_id" required="1" readonly="1"/>
                        </tree>
                    </field>
                </group>

                <group string="Packages To Move" groups="stock.group_tracking_lot">
                    <div class="alert alert-secondary mb-2 p-3" style="background-color: #f8f9fa; border-left: 4px solid #6c757d; border-radius: 4px;">
                        <i class="fa fa-box mr-2" style="color: #6c757d;"/>
                        <span style="color: #495057; font-size: 13px;">The source package will be moved entirely. If you specify a destination package, the source package will be put in the destination package.</span>
                    </div>
                </group>

                <footer>
                    <button name="button_confirm" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>