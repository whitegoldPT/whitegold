<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partial Receive Reason Wizard -->
    <record id="partial_receive_reason_wizard_view" model="ir.ui.view">
        <field name="name">partial.receive.reason.wizard.form</field>
        <field name="model">partial.receive.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Partial Receive Reason">
                <group>
                    <group>
                        <field name="deleted_lines_info" nolabel="1" readonly="1" invisible="not deleted_lines_info"/>
                        <label for="reason" string="Please specify why you are not receiving all products:"/>
                        <field name="reason" nolabel="1" placeholder="Enter reason (e.g., damaged products, missing items, etc.)" required="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>