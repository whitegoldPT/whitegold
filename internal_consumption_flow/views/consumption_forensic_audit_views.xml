<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consumption_forensic_audit_tree" model="ir.ui.view">
        <field name="name">consumption.forensic.audit.tree</field>
        <field name="model">consumption.forensic.audit</field>
        <field name="arch" type="xml">
            <list string="Audit Alerts" decoration-danger="risk_level == 'high'" decoration-warning="risk_level == 'medium'">
                <field name="create_date"/>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="audit_type"/>
                <field name="risk_level" widget="badge" decoration-danger="risk_level == 'high'" decoration-warning="risk_level == 'medium'" decoration-info="risk_level == 'low'"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_consumption_forensic_audit_form" model="ir.ui.view">
        <field name="name">consumption.forensic.audit.form</field>
        <field name="model">consumption.forensic.audit</field>
        <field name="arch" type="xml">
            <form string="Audit Alert">
                <header>
                    <button name="action_verify" string="Verify Anomaly" type="object" class="oe_highlight" invisible="state != 'new'"/>
                    <button name="action_dismiss" string="False Positive" type="object" invisible="state != 'new'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="audit_type" readonly="1"/>
                            <field name="risk_level" readonly="1"/>
                            <field name="request_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="employee_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="details" string="Technical Analysis">
                            <field name="details" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_consumption_forensic_audit" model="ir.actions.act_window">
        <field name="name">Audit Alerts</field>
        <field name="res_model">consumption.forensic.audit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
             <p class="o_view_nocontent_smiling_face">
                No anomalies detected yet!
            </p>
            <p>
                The Forensic Eye monitors all consumption requests for duplicates, abnormal quantities, and leakage.
            </p>
        </field>
    </record>
</odoo>
