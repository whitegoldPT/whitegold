<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consumption_request_tree" model="ir.ui.view">
        <field name="name">consumption.request.tree</field>
        <field name="model">consumption.request</field>
        <field name="arch" type="xml">
            <list string="Consumption Requests" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="request_date"/>
                <field name="risk_score" widget="priority" readonly="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state == 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="view_consumption_request_form" model="ir.ui.view">
        <field name="name">consumption.request.form</field>
        <field name="model">consumption.request</field>
        <field name="arch" type="xml">
            <form string="Consumption Request">
                <header>
                    <button name="action_submit" string="Submit Request" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'submitted' or not is_department_manager" groups="internal_consumption_flow.group_consumption_manager,internal_consumption_flow.group_consumption_user,base.group_system"/>
                    <button name="action_dispatch" string="Dispatch (Send)" type="object" class="oe_highlight" invisible="state != 'approved'" groups="internal_consumption_flow.group_consumption_dispatcher,internal_consumption_flow.group_consumption_manager,base.group_system"/>
                    <button name="action_receive" string="Receive (Done)" type="object" class="oe_highlight" invisible="state != 'dispatched'"/>
                    <button name="action_refuse" string="Refuse" type="object" invisible="state not in ('submitted', 'approved')" groups="internal_consumption_flow.group_consumption_manager,base.group_system"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'submitted', 'refused')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state not in ('refused', 'cancelled')" groups="internal_consumption_flow.group_consumption_manager,base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,dispatched,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_department_manager" invisible="1"/>
                        <button name="action_view_picking" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_send_id and not picking_receive_id">
                            <span class="o_stat_text">Transfers</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="requester_info">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="request_date" readonly="state != 'draft'"/>
                        </group>
                        <group name="picking_info">
                            <field name="picking_send_id"/>
                            <field name="picking_receive_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                    <field name="account_id" options="{'no_create': True}"/>
                                    <field name="analytic_distribution" widget="analytic_distribution" optional="show" options="{'account_field': 'account_id'}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Forensic Audit" name="audit" invisible="risk_score == '0'">
                            <field name="audit_log_ids" readonly="1">
                                <list decoration-danger="risk_level == 'high'">
                                    <field name="audit_type"/>
                                    <field name="name"/>
                                    <field name="risk_level" widget="badge"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_consumption_request" model="ir.actions.act_window">
        <field name="name">Consumption Requests</field>
        <field name="res_model">consumption.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first internal consumption request!
            </p>
        </field>
    </record>
</odoo>
