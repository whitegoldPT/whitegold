<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="consumption_approval_category_view_tree" model="ir.ui.view">
        <field name="name">consumption.approval.category.tree</field>
        <field name="model">consumption.approval.category</field>
        <field name="arch" type="xml">
            <list string="Approval Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="approver_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="consumption_approval_category_view_form" model="ir.ui.view">
        <field name="name">consumption.approval.category.form</field>
        <field name="model">consumption.approval.category</field>
        <field name="arch" type="xml">
            <form string="Approval Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Required Approvers">
                        <field name="approver_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="consumption_approval_category_action" model="ir.actions.act_window">
        <field name="name">Approval Categories</field>
        <field name="res_model">consumption.approval.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
