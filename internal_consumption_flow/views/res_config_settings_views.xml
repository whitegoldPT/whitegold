<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consumption_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.consumption</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Internal Consumption Flow" id="consumption_settings">
                    <setting string="Transit Location" help="Used as intermediate step.">
                        <field name="transit_location_id"/>
                    </setting>
                    <setting string="Consumption Location" help="Final virtual location for expensing.">
                        <field name="consumption_location_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="action_consumption_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'internal_consumption_flow', 'bin_size': False}</field>
    </record>
</odoo>
