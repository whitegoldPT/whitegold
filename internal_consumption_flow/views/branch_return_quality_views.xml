<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Stock Picking Form View for Branch Returns & Quality Check -->
    <record id="view_picking_form_inherit_branch_return_quality" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.branch.return.quality</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_retwh_receipt" invisible="1"/>
                <!-- Button to return from a completed shipment directly to Returns Warehouse RETWH -->
                <button name="action_return_to_retwh" string="مرتجع لمخزن المرتجعات" type="object" class="btn-secondary"
                        invisible="state != 'done' or is_retwh_receipt" groups="stock.group_stock_user"/>
                <!-- Button to trigger quality check for pickings entering RETWH (even if internal transfer) -->
                <button name="action_create_quality_check" type="object" string="طلب فحص الجودة" class="oe_highlight"
                        invisible="(has_quality_check and quality_status != 'no_quality') or state in ('done', 'cancel') or not is_retwh_receipt"
                        groups="quality_test.group_quality_test_user"/>
            </xpath>
        </field>
    </record>
</odoo>
