<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Virtual Transit Location for Internal Consumption -->
        <record id="stock_location_consumption_transit" model="stock.location">
            <field name="name">Consumption Transit</field>
            <field name="usage">transit</field>
            <field name="location_id" ref="stock.stock_location_locations_virtual"/>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Default Virtual Location for Internal Consumption -->
        <record id="stock_location_internal_consumption" model="stock.location">
            <field name="name">Internal Consumption</field>
            <field name="usage">inventory</field>
            <field name="location_id" ref="stock.stock_location_locations_virtual"/>
            <field name="company_id" eval="False"/>
        </record>

        <record id="consumption_transit_param" model="ir.config_parameter">
            <field name="key">internal_consumption_flow.transit_location_id</field>
            <field name="value" ref="stock_location_consumption_transit"/>
        </record>

        <record id="consumption_dest_param" model="ir.config_parameter">
            <field name="key">internal_consumption_flow.consumption_location_id</field>
            <field name="value" ref="stock_location_internal_consumption"/>
        </record>
    </data>
</odoo>
