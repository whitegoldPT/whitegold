<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="module_category_internal_consumption" model="ir.module.category">
        <field name="name">Internal Consumption</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_consumption_user" model="res.groups">
        <field name="name">User (Requester)</field>
        <field name="category_id" ref="module_category_internal_consumption"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_consumption_manager" model="res.groups">
        <field name="name">Manager (Approver)</field>
        <field name="category_id" ref="module_category_internal_consumption"/>
        <field name="implied_ids" eval="[(4, ref('group_consumption_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_consumption_dispatcher" model="res.groups">
        <field name="name">Dispatcher (Warehouse)</field>
        <field name="category_id" ref="module_category_internal_consumption"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
