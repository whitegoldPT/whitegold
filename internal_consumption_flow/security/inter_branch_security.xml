<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_inter_branch_transfer" model="ir.module.category">
        <field name="name">Inter-Branch Transfer / التحويلات بين الفروع</field>
        <field name="description">إدارة وتتبع طلبات التحويلات المخزنية بين الفروع والمخزن الرئيسي</field>
        <field name="sequence">15</field>
    </record>

    <record id="group_inter_branch_user" model="res.groups">
        <field name="name">Branch User / موظف الفرع</field>
        <field name="category_id" ref="module_category_inter_branch_transfer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_inter_branch_manager" model="res.groups">
        <field name="name">Transfer Manager / مدير التحويلات والمخازن</field>
        <field name="category_id" ref="module_category_inter_branch_transfer"/>
        <field name="implied_ids" eval="[(4, ref('group_inter_branch_user'))]"/>
    </record>

</odoo>
