# -*- coding: utf-8 -*-
from odoo import models, fields, api, _
from odoo.exceptions import UserError, ValidationError


class StockInterBranchRequest(models.Model):
    _name = 'stock.inter.branch.request'
    _description = 'Inter-Branch Transfer Request (طلب تحويل مخزني بين الفروع)'
    _inherit = ['mail.thread', 'mail.activity.mixin']
    _order = 'id desc'

    name = fields.Char(
        string='Request No / رقم الطلب',
        required=True,
        copy=False,
        readonly=True,
        default=lambda self: _('New')
    )
    date = fields.Date(
        string='Request Date / تاريخ الطلب',
        required=True,
        default=fields.Date.context_today,
        tracking=True
    )
    user_id = fields.Many2one(
        'res.users',
        string='Requested By / مقدم الطلب',
        required=True,
        default=lambda self: self.env.user,
        tracking=True
    )
    @api.model
    def _default_is_manager(self):
        return self.env.user.has_group('internal_consumption_flow.group_inter_branch_manager')

    is_manager = fields.Boolean(
        string='Is Stock / HQ Manager',
        compute='_compute_is_manager',
        default=lambda self: self._default_is_manager()
    )

    def _compute_is_manager(self):
        is_mgr = self._default_is_manager()
        for rec in self:
            rec.is_manager = is_mgr

    @api.model
    def _get_branch_warehouse_domain(self):
        user = self.env.user
        current_company = self.env.company
        is_mgr = user.has_group('internal_consumption_flow.group_inter_branch_manager')
        if is_mgr:
            # HQ or Manager can request for any branch warehouse
            return [('id', '!=', False)]
        else:
            # Branch employee: restricted to warehouses belonging to their branch company
            return [('company_id', '=', current_company.id)]

    @api.model
    def _default_branch_warehouse(self):
        current_company = self.env.company
        if current_company.id != 1:
            wh = self.env['stock.warehouse'].sudo().search([('company_id', '=', current_company.id)], limit=1)
            if wh:
                return wh.id
        return False

    @api.model
    def _default_source_warehouse(self):
        wh = self.env['stock.warehouse'].sudo().search([('company_id', '=', 1), ('code', '=', 'FGWH')], limit=1)
        if not wh:
            wh = self.env['stock.warehouse'].sudo().search([('company_id', '=', 1)], limit=1)
        return wh.id if wh else False

    @api.model
    def _default_retwh_warehouse(self):
        """Return the RETWH warehouse for the current company — same warehouse
        used by quality_test and MRP return modules."""
        comp_id = self.env.company.id
        # Try current company first, then any company
        wh = self.env['stock.warehouse'].sudo().search([
            ('code', '=', 'RETWH'), ('company_id', '=', comp_id)
        ], limit=1)
        if not wh:
            wh = self.env['stock.warehouse'].sudo().search([('code', '=', 'RETWH')], limit=1)
        return wh.id if wh else False

    @api.model
    def default_get(self, fields_list):
        """Auto-fill source_warehouse_id with RETWH when opening from
        the returns-only screen (context: default_request_type='return')."""
        defaults = super().default_get(fields_list)
        if defaults.get('request_type') == 'return' or \
                self.env.context.get('default_request_type') == 'return':
            defaults['request_type'] = 'return'
            if 'source_warehouse_id' in fields_list and not defaults.get('source_warehouse_id'):
                retwh = self._default_retwh_warehouse()
                if retwh:
                    defaults['source_warehouse_id'] = retwh
        return defaults

    branch_warehouse_id = fields.Many2one(
        'stock.warehouse',
        string='Branch Warehouse / مخزن الفرع الطالب',
        required=True,
        domain=lambda self: self._get_branch_warehouse_domain(),
        default=lambda self: self._default_branch_warehouse(),
        tracking=True
    )
    source_warehouse_id = fields.Many2one(
        'stock.warehouse',
        string='Source Warehouse / المخزن المصروف منه (الرئيسي أو فرع آخر)',
        required=False,
        default=lambda self: self._default_source_warehouse(),
        tracking=True
    )
    transit_location_id = fields.Many2one(
        'stock.location',
        string='Transit Location / المخزن الوسيط (الترانزيت)',
        domain="[('usage', '=', 'transit')]",
        compute='_compute_transit_location',
        store=True,
        readonly=False,
        precompute=True,
        help='الموقع الوسيط الذي تبقى فيه البضاعة أثناء مرحلة النقل بين المخزنين'
    )
    request_type = fields.Selection([
        ('transfer', 'طلب تحويل بضاعة (من المخزن الرئيسي إلى الفرع)'),
        ('return', 'طلب مرتجع فرع (من الفرع إلى مخزن المرتجعات)'),
    ], string='Request Type / نوع الطلب', default='transfer', required=True, tracking=True)

    @api.onchange('request_type')
    def _onchange_request_type(self):
        if self.request_type == 'return':
            ret_wh = self.env['stock.warehouse'].sudo().search([('code', '=', 'RETWH')], limit=1)
            if ret_wh:
                self.source_warehouse_id = ret_wh.id
        else:
            self.source_warehouse_id = self._default_source_warehouse()

    company_id = fields.Many2one(
        'res.company',
        string='Company / الشركة',
        default=lambda self: self.env.company,
        required=True
    )
    state = fields.Selection([
        ('draft', 'مسودة'),
        ('to_approve', 'بانتظار موافقة المخزن الرئيسي'),
        ('approved', 'معتمد وجاهز للشحن'),
        ('in_transit', 'في الطريق (تم الشحن)'),
        ('done', 'تم الاستلام بالفرع (مكتمل)'),
        ('cancel', 'ملغي')
    ], string='Status / الحالة', default='draft', tracking=True, copy=False)

    notes = fields.Text(string='Notes / ملاحظات وسبب التحويل')

    line_ids = fields.One2many(
        'stock.inter.branch.request.line',
        'request_id',
        string='Requested Items / الأصناف المطلوبة',
        copy=True
    )

    picking_out_id = fields.Many2one(
        'stock.picking',
        string='Dispatch Transfer / إذن الصرف للشحن',
        readonly=True,
        copy=False
    )
    picking_in_id = fields.Many2one(
        'stock.picking',
        string='Receipt Transfer / إذن الاستلام بالفرع',
        readonly=True,
        copy=False
    )
    picking_count = fields.Integer(
        string='Pickings Count',
        compute='_compute_picking_count'
    )

    @api.depends('branch_warehouse_id', 'source_warehouse_id')
    def _compute_transit_location(self):
        for rec in self:
            if rec.branch_warehouse_id and rec.source_warehouse_id:
                # If warehouses belong to different companies, use inter-company transit
                if rec.branch_warehouse_id.company_id != rec.source_warehouse_id.company_id:
                    transit = self.env['stock.location'].search([
                        ('usage', '=', 'transit'),
                        ('company_id', '=', False)
                    ], limit=1)
                    if not transit:
                        transit = rec.source_warehouse_id.company_id.internal_transit_location_id
                    rec.transit_location_id = transit
                else:
                    # Same company
                    rec.transit_location_id = rec.source_warehouse_id.company_id.internal_transit_location_id
            else:
                rec.transit_location_id = False

    @api.onchange('branch_warehouse_id', 'source_warehouse_id')
    def _onchange_warehouses(self):
        self._compute_transit_location()

    @api.depends('picking_out_id', 'picking_in_id')
    def _compute_picking_count(self):
        for rec in self:
            count = 0
            if rec.picking_out_id:
                count += 1
            if rec.picking_in_id:
                count += 1
            rec.picking_count = count

    @api.model_create_multi
    def create(self, vals_list):
        for vals in vals_list:
            if vals.get('name', _('New')) == _('New'):
                vals['name'] = getattr(self.env['ir.sequence'], 'next_by_code')('stock.inter.branch.request') or _('New')
        return super().create(vals_list)

    def action_submit(self):
        for rec in self:
            if not rec.line_ids:
                raise UserError(_("يرجى إضافة صنف واحد على الأقل في طلب التحويل."))
            if rec.request_type == 'return' and not rec.source_warehouse_id:
                ret_wh = self.env['stock.warehouse'].sudo().search([('code', '=', 'RETWH')], limit=1)
                if ret_wh:
                    rec.source_warehouse_id = ret_wh.id
            if rec.source_warehouse_id and rec.branch_warehouse_id == rec.source_warehouse_id:
                raise UserError(_("لا يمكن أن يكون مخزن المصدر هو نفسه مخزن الوجهة."))
            rec.state = 'to_approve'

    def action_approve(self):
        for rec in self:
            if not rec.line_ids:
                raise UserError(_("لا يمكن اعتماد طلب تحويل بدون أصناف."))
            if not rec.source_warehouse_id:
                if rec.request_type == 'return':
                    ret_wh = self.env['stock.warehouse'].sudo().search([('code', '=', 'RETWH')], limit=1)
                    if ret_wh:
                        rec.source_warehouse_id = ret_wh.id
                    else:
                        raise UserError(_("لم يتم العثور على مخزن المرتجعات (RETWH)."))
                else:
                    raise UserError(_("يرجى تحديد المخزن المصروف منه (Source Warehouse) قبل اعتماد الطلب."))

            if rec.branch_warehouse_id == rec.source_warehouse_id:
                raise UserError(_("لا يمكن أن يكون مخزن الفرع هو نفسه مخزن الوجهة."))
            if not rec.transit_location_id:
                rec._compute_transit_location()
            if not rec.transit_location_id:
                transit = self.env['stock.location'].sudo().search([('usage', '=', 'transit')], limit=1)
                if transit:
                    rec.transit_location_id = transit
                else:
                    raise UserError(_("لم يتم تحديد موقع الترانزيت الوسيط. يرجى التحقق من إعدادات المخازن."))

            # Determine from_wh (sender) and to_wh (receiver)
            if rec.request_type == 'return':
                from_wh = rec.branch_warehouse_id
                to_wh = rec.source_warehouse_id
            else:
                from_wh = rec.source_warehouse_id
                to_wh = rec.branch_warehouse_id

            # 1. Create Outbound Picking (from_wh -> Transit)
            picking_type_out = from_wh.int_type_id or from_wh.out_type_id
            if not picking_type_out:
                raise UserError(_("لم يتم العثور على نوع عملية صرف للمخزن المصروف منه: %s") % from_wh.name)

            out_move_vals = []
            for line in rec.line_ids:
                out_move_vals.append((0, 0, {
                    'name': f"{rec.name}: {line.product_id.display_name}",
                    'product_id': line.product_id.id,
                    'product_uom': line.product_uom_id.id,
                    'product_uom_qty': line.qty_requested,
                    'location_id': from_wh.lot_stock_id.id,
                    'location_dest_id': rec.transit_location_id.id,
                    'company_id': from_wh.company_id.id,
                }))

            picking_out = self.env['stock.picking'].sudo().create({
                'picking_type_id': picking_type_out.id,
                'location_id': from_wh.lot_stock_id.id,
                'location_dest_id': rec.transit_location_id.id,
                'origin': rec.name,
                'company_id': from_wh.company_id.id,
                'move_ids': out_move_vals,
                'inter_branch_request_id': rec.id,
            })
            picking_out.action_confirm()
            rec.picking_out_id = picking_out.id

            # 2. Create Inbound Picking (Transit -> to_wh)
            picking_type_in = to_wh.int_type_id or to_wh.in_type_id
            if not picking_type_in:
                raise UserError(_("لم يتم العثور على نوع عملية استلام للمخزن المستلم: %s") % to_wh.name)

            in_move_vals = []
            for line in rec.line_ids:
                in_move_vals.append((0, 0, {
                    'name': f"{rec.name}: {line.product_id.display_name}",
                    'product_id': line.product_id.id,
                    'product_uom': line.product_uom_id.id,
                    'product_uom_qty': line.qty_requested,
                    'location_id': rec.transit_location_id.id,
                    'location_dest_id': to_wh.lot_stock_id.id,
                    'company_id': to_wh.company_id.id,
                }))

            picking_in = self.env['stock.picking'].sudo().create({
                'picking_type_id': picking_type_in.id,
                'location_id': rec.transit_location_id.id,
                'location_dest_id': to_wh.lot_stock_id.id,
                'origin': rec.name,
                'company_id': to_wh.company_id.id,
                'move_ids': in_move_vals,
                'inter_branch_request_id': rec.id,
            })
            picking_in.action_confirm()
            rec.picking_in_id = picking_in.id

            rec.state = 'approved'
            getattr(rec, 'message_post')(body=_(
                "تم اعتماد الطلب بنجاح وإنشاء أذونات الصرف والاستلام رقم: %s و %s"
            ) % (picking_out.name, picking_in.name))

    def action_reject(self):
        for rec in self:
            rec.state = 'cancel'
            getattr(rec, 'message_post')(body=_("تم رفض طلب التحويل."))

    def action_cancel(self):
        for rec in self:
            if rec.picking_out_id and rec.picking_out_id.state == 'done':
                raise UserError(_("لا يمكن إلغاء الطلب بعد أن تم صرف الشحنة من المخزن الرئيسي."))
            if rec.picking_out_id and rec.picking_out_id.state not in ('done', 'cancel'):
                rec.picking_out_id.action_cancel()
            if rec.picking_in_id and rec.picking_in_id.state not in ('done', 'cancel'):
                rec.picking_in_id.action_cancel()
            rec.state = 'cancel'

    def action_draft(self):
        for rec in self:
            rec.state = 'draft'

    def action_view_pickings(self):
        self.ensure_one()
        pickings = self.sudo().picking_out_id | self.sudo().picking_in_id
        company_ids = pickings.mapped('company_id').ids
        if len(pickings) == 1:
            return {
                'name': _('Transfers'),
                'type': 'ir.actions.act_window',
                'res_model': 'stock.picking',
                'res_id': pickings.id,
                'view_mode': 'form',
                'context': {'allowed_company_ids': company_ids or False},
            }
        return {
            'name': _('Transfers for %s') % self.name,
            'type': 'ir.actions.act_window',
            'res_model': 'stock.picking',
            'view_mode': 'list,form',
            'domain': [('id', 'in', pickings.ids)],
            'context': {'allowed_company_ids': company_ids or False},
        }


class StockInterBranchRequestLine(models.Model):
    _name = 'stock.inter.branch.request.line'
    _description = 'Inter-Branch Transfer Request Line'

    request_id = fields.Many2one(
        'stock.inter.branch.request',
        string='Request',
        ondelete='cascade',
        required=True
    )
    product_id = fields.Many2one(
        'product.product',
        string='Product / الصنف',
        required=True
    )
    product_uom_id = fields.Many2one(
        'uom.uom',
        string='Unit of Measure / الوحدة',
        required=True
    )
    qty_requested = fields.Float(
        string='Requested Qty / الكمية المطلوبة',
        required=True,
        default=1.0
    )
    qty_dispatched = fields.Float(
        string='Dispatched Qty / الكمية المشحونة',
        compute='_compute_qtys',
        store=True
    )
    qty_received = fields.Float(
        string='Received Qty / الكمية المستلمة',
        compute='_compute_qtys',
        store=True
    )
    available_qty_source = fields.Float(
        string='Available in Source WH / المتاح بمخزن الإرسال',
        compute='_compute_source_qty'
    )
    notes = fields.Char(string='Notes / ملاحظات')

    @api.onchange('product_id')
    def _onchange_product_id(self):
        if self.product_id:
            self.product_uom_id = self.product_id.uom_id.id

    @api.depends('request_id.source_warehouse_id', 'request_id.branch_warehouse_id', 'request_id.request_type', 'product_id')
    def _compute_source_qty(self):
        for line in self:
            req = line.request_id
            wh = req.branch_warehouse_id if req.request_type == 'return' else req.source_warehouse_id
            if wh and line.product_id:
                location = wh.lot_stock_id
                quant = self.env['stock.quant'].search([
                    ('product_id', '=', line.product_id.id),
                    ('location_id', '=', location.id)
                ])
                line.available_qty_source = sum(quant.mapped('quantity')) - sum(quant.mapped('reserved_quantity'))
            else:
                line.available_qty_source = 0.0

    @api.depends('request_id.picking_out_id.state', 'request_id.picking_in_id.state')
    def _compute_qtys(self):
        for line in self:
            dispatched = 0.0
            received = 0.0
            req = line.request_id

            if req.picking_out_id:
                moves_out = req.picking_out_id.move_ids.filtered(lambda m: m.product_id == line.product_id)
                if req.picking_out_id.state == 'done':
                    dispatched = sum(moves_out.mapped('quantity'))
                else:
                    dispatched = sum(moves_out.mapped('product_uom_qty'))

            if req.picking_in_id:
                moves_in = req.picking_in_id.move_ids.filtered(lambda m: m.product_id == line.product_id)
                if req.picking_in_id.state == 'done':
                    received = sum(moves_in.mapped('quantity'))
                else:
                    received = sum(moves_in.mapped('product_uom_qty'))

            line.qty_dispatched = dispatched
            line.qty_received = received
