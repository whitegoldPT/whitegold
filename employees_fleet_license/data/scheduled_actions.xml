<odoo>
    <data noupdate="1">

        <record id="ir_cron_check_license_expiration" model="ir.cron">
            <field name="name">Driver License: Check Expirations</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._check_license_expirations()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="ir_cron_check_license_expiration" model="ir.cron">
            <field name="name">Driver License: Check Expirations</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._check_license_expirations()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- 'numbercall' removed as it is no longer valid in Odoo 18 -->
        </record>

    </data>
</odoo>