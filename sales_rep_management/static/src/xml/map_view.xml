<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="sales_rep_management.markerPopup" t-inherit="spd_leaflet_map.markerPopup" t-inherit-mode="extension" owl="1">
       <xpath expr="//div" position="replace">
            <div>
                <!-- Clickable Name (First field is typically the name) -->
                <div t-if="fields.length > 0" class="text-center mb-2">
                    <button class="btn btn-link p-0 fw-bold o-map-renderer--popup-buttons-open" 
                            style="font-size: 1.1em; text-decoration: none;"
                            t-esc="fields[0].value"/>
                </div>

                <!-- Table for remaining fields -->
                <table class="o-map-renderer--popup-table align-top" t-if="fields.length > 1">
                    <thead>
                        <tr>
                            <th colspan="2"></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Loop starting from the second field -->
                        <tr t-foreach="fields.slice(1)" t-as="field" t-key="field.id">
                            <td class="o-map-renderer--popup-table-content-value align-baseline">
                                <t t-esc="field.value"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
       </xpath>
    </t>

</templates>
