<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Sales Rep Management Categories -->
        <record id="module_category_sales_rep" model="ir.module.category">
            <field name="name">Sales Rep Management</field>
            <field name="description">Manage sales representatives, routes and visits</field>
            <field name="sequence">10</field>
        </record>

        <!-- Sales Representative Group -->
        <record id="group_sales_rep_user" model="res.groups">
            <field name="name">Sales Representative</field>
            <field name="category_id" ref="module_category_sales_rep"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Sales representatives can view their routes and record visits</field>
        </record>

        <!-- Sales Supervisor Group -->
        <record id="group_sales_supervisor" model="res.groups">
            <field name="name">Sales Supervisor</field>
            <field name="category_id" ref="module_category_sales_rep"/>
            <field name="implied_ids" eval="[(4, ref('group_sales_rep_user'))]"/>
            <field name="comment">Supervisors can manage their team's routes and approve reports</field>
        </record>

        <!-- Sales Manager Group -->
        <record id="group_sales_manager" model="res.groups">
            <field name="name">Sales Manager</field>
            <field name="category_id" ref="module_category_sales_rep"/>
            <field name="implied_ids" eval="[(4, ref('group_sales_supervisor'))]"/>
            <field name="comment">Sales managers have full access to all sales rep management features</field>
        </record>

        <!-- Finance Access Group for Collections -->
        <record id="group_finance_collections" model="res.groups">
            <field name="name">Finance - Collections Access</field>
            <field name="category_id" ref="module_category_sales_rep"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Finance team can view and manage collection data</field>
        </record>

        <!-- Record Rules -->
        
        <!-- Sales Rep can only see their own routes -->
        <record id="route_rule_sales_rep" model="ir.rule">
            <field name="name">Sales Rep: Own Routes Only</field>
            <field name="model_id" ref="model_sales_rep_route"/>
            <field name="domain_force">[('sales_rep_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sales_rep_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Sales Rep can only see their own visits -->
        <record id="visit_rule_sales_rep" model="ir.rule">
            <field name="name">Sales Rep: Own Visits Only</field>
            <field name="model_id" ref="model_sales_rep_visit"/>
            <field name="domain_force">[('route_id.sales_rep_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sales_rep_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Sales Rep can only see their own collections -->
        <record id="collection_rule_sales_rep" model="ir.rule">
            <field name="name">Sales Rep: Own Collections Only</field>
            <field name="model_id" ref="model_sales_rep_collection"/>
            <field name="domain_force">[('visit_id.route_id.sales_rep_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sales_rep_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="route_customer_rule_sales_rep" model="ir.rule">
            <field name="name">Sales Rep: Own Route Customers Only</field>
            <field name="model_id" ref="model_sales_route_customer"/>
            <field name="domain_force">[('route_id.sales_rep_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sales_rep_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- <record id="route_rule_supervisor" model="ir.rule">
            <field name="name">Supervisor: Team Routes</field>
            <field name="model_id" ref="model_sales_rep_route"/>
            <field name="domain_force">[('supervisor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sales_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record> -->

        <record id="visit_rule_supervisor" model="ir.rule">
            <field name="name">Supervisor: Team Visits</field>
            <field name="model_id" ref="model_sales_rep_visit"/>
            <field name="domain_force">[('route_id.supervisor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sales_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="route_customer_rule_supervisor" model="ir.rule">
            <field name="name">Supervisor: Team Route Customers</field>
            <field name="model_id" ref="model_sales_route_customer"/>
            <field name="domain_force">[('route_id.supervisor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sales_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Sales Manager: Full Access (All Records) -->
        <record id="route_rule_manager" model="ir.rule">
            <field name="name">Sales Manager: All Routes</field>
            <field name="model_id" ref="model_sales_rep_route"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="visit_rule_manager" model="ir.rule">
            <field name="name">Sales Manager: All Visits</field>
            <field name="model_id" ref="model_sales_rep_visit"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="collection_rule_manager" model="ir.rule">
            <field name="name">Sales Manager: All Collections</field>
            <field name="model_id" ref="model_sales_rep_collection"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="route_customer_rule_manager" model="ir.rule">
            <field name="name">Sales Manager: All Route Customers</field>
            <field name="model_id" ref="model_sales_route_customer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>