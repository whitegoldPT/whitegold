<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Collection Receipt Template -->
        <template id="report_collection_receipt_document">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center">
                        <h2>Collection Receipt</h2>
                    </div>
                    
                    <div class="row mt32">
                        <div class="col-6">
                            <h4>Collection Details</h4>
                            <strong>Receipt Number:</strong> <span t-field="o.receipt_number"/><br/>
                            <strong>Collection Reference:</strong> <span t-field="o.name"/><br/>
                            <strong>Date &amp; Time:</strong> <span t-field="o.collection_date" t-options="{'widget': 'datetime'}"/><br/>
                            <strong>Sales Representative:</strong> <span t-field="o.sales_rep_id.name"/><br/>
                        </div>
                        <div class="col-6">
                            <h4>Customer Information</h4>
                            <strong>Customer:</strong> <span t-field="o.partner_id.name"/><br/>
                            <span t-if="o.partner_id.street" t-field="o.partner_id.street"/><br/>
                            <span t-if="o.partner_id.city" t-field="o.partner_id.city"/><br/>
                            <span t-if="o.partner_id.phone">Phone: <span t-field="o.partner_id.phone"/></span><br/>
                        </div>
                    </div>

                    <div class="row mt32">
                        <div class="col-12">
                            <h4>Payment Information</h4>
                            <table class="table table-borderless">
                                <tr>
                                    <td width="30%"><strong>Amount Collected:</strong></td>
                                    <td><h3 class="text-success">$<span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></h3></td>
                                </tr>
                                <tr>
                                    <td><strong>Payment Method:</strong></td>
                                    <td><span t-field="o.payment_method"/></td>
                                </tr>
                                <tr t-if="o.payment_reference">
                                    <td><strong>Payment Reference:</strong></td>
                                    <td><span t-field="o.payment_reference"/></td>
                                </tr>
                                <tr t-if="o.is_partial_payment">
                                    <td><strong>Payment Type:</strong></td>
                                    <td><span class="badge badge-warning">Partial Payment</span></td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="row mt32" t-if="o.invoice_ids">
                        <div class="col-12">
                            <h4>Related Invoices</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Invoice Number</th>
                                        <th>Invoice Date</th>
                                        <th>Total Amount</th>
                                        <th>Remaining</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.invoice_ids" t-as="invoice">
                                        <td><span t-field="invoice.name"/></td>
                                        <td><span t-field="invoice.invoice_date"/></td>
                                        <td>$<span t-field="invoice.amount_total"/></td>
                                        <td>$<span t-field="invoice.amount_residual"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="row mt32" t-if="o.notes">
                        <div class="col-12">
                            <h4>Notes</h4>
                            <p t-field="o.notes"/>
                        </div>
                    </div>

                    <div class="row mt64">
                        <div class="col-6">
                            <div class="text-center">
                                <p>_________________________</p>
                                <p><strong>Customer Signature</strong></p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center">
                                <p>_________________________</p>
                                <p><strong>Sales Representative</strong></p>
                                <p><span t-field="o.sales_rep_id.name"/></p>
                            </div>
                        </div>
                    </div>

                    <div class="row mt32">
                        <div class="col-12 text-center">
                            <p class="text-muted">
                                This receipt was generated on <span t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
                            </p>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Collection Receipt Report Action -->
        <record id="action_report_collection_receipt" model="ir.actions.report">
            <field name="name">Collection Receipt</field>
            <field name="model">sales.rep.collection</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sales_rep_management.report_collection_receipt_document</field>
            <field name="report_file">sales_rep_management.report_collection_receipt_document</field>
            <field name="binding_model_id" ref="model_sales_rep_collection"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>