<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Daily Report Template -->
        <template id="report_daily_report_document">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center">
                        <h2>Daily Sales Report</h2>
                        <h4><span t-field="o.report_date"/></h4>
                    </div>
                    
                    <div class="row mt32">
                        <div class="col-6">
                            <h4>Sales Representative</h4>
                            <strong>Name:</strong> <span t-field="o.sales_rep_id.name"/><br/>
                            <strong>Code:</strong> <span t-field="o.sales_rep_id.code"/><br/>
                            <strong>Report Reference:</strong> <span t-field="o.name"/><br/>
                        </div>
                        <div class="col-6">
                            <h4>Performance Summary</h4>
                            <strong>Visits Planned:</strong> <span t-field="o.total_visits_planned"/><br/>
                            <strong>Visits Completed:</strong> <span t-field="o.total_visits_completed"/><br/>
                            <strong>Completion Rate:</strong> <span t-field="o.completion_rate"/>%<br/>
                        </div>
                    </div>

                    <div class="row mt32">
                        <div class="col-12">
                            <h4>Financial Summary</h4>
                            <div class="row">
                                <div class="col-6">
                                    <div class="card border-success">
                                        <div class="card-body text-center">
                                            <h3 class="text-success">$<span t-field="o.total_sales_amount"/></h3>
                                            <p class="card-text">Total Sales</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="card border-primary">
                                        <div class="card-body text-center">
                                            <h3 class="text-primary">$<span t-field="o.total_collections"/></h3>
                                            <p class="card-text">Total Collections</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt32" t-if="o.route_ids">
                        <div class="col-12">
                            <h4>Routes Covered</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Route Name</th>
                                        <th>Planned Visits</th>
                                        <th>Completed Visits</th>
                                        <th>Completion Rate</th>
                                        <th>Sales</th>
                                        <th>Collections</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.route_ids" t-as="route">
                                        <td><span t-field="route.name"/></td>
                                        <td><span t-field="route.planned_visits"/></td>
                                        <td><span t-field="route.completed_visits"/></td>
                                        <td><span t-field="route.completion_rate"/>%</td>
                                        <td>$<span t-field="route.actual_sales"/></td>
                                        <td>$<span t-field="route.actual_collections"/></td>
                                        <td><span t-field="route.state"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="row mt32" t-if="o.summary_notes">
                        <div class="col-12">
                            <h4>Summary Notes</h4>
                            <p t-field="o.summary_notes"/>
                        </div>
                    </div>

                    <div class="row mt32" t-if="o.challenges_faced">
                        <div class="col-12">
                            <h4>Challenges Faced</h4>
                            <p t-field="o.challenges_faced"/>
                        </div>
                    </div>

                    <div class="row mt32" t-if="o.next_day_plan">
                        <div class="col-12">
                            <h4>Next Day Plan</h4>
                            <p t-field="o.next_day_plan"/>
                        </div>
                    </div>

                    <div class="row mt64">
                        <div class="col-6">
                            <div class="text-center">
                                <p>_________________________</p>
                                <p><strong>Sales Representative</strong></p>
                                <p><span t-field="o.sales_rep_id.name"/></p>
                                <p>Date: <span t-field="o.submitted_date" t-options="{'widget': 'date'}"/></p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center">
                                <p>_________________________</p>
                                <p><strong>Supervisor Approval</strong></p>
                                <p t-if="o.approved_by"><span t-field="o.approved_by.name"/></p>
                                <p t-if="o.approved_date">Date: <span t-field="o.approved_date" t-options="{'widget': 'date'}"/></p>
                            </div>
                        </div>
                    </div>

                    <div class="row mt32">
                        <div class="col-12 text-center">
                            <p class="text-muted">
                                Report Status: <span t-field="o.state" class="badge badge-info"/>
                            </p>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Daily Report Action -->
        <record id="action_report_daily_report" model="ir.actions.report">
            <field name="name">Daily Report</field>
            <field name="model">sales.rep.daily.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sales_rep_management.report_daily_report_document</field>
            <field name="report_file">sales_rep_management.report_daily_report_document</field>
            <field name="binding_model_id" ref="model_sales_rep_daily_report"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>