<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="cron_create_recurrent_routes" model="ir.cron">
            <field name="name">Create Recurrent Sales Routes</field>
            <field name="model_id" ref="model_sales_rep_route"/>
            <field name="state">code</field>
            <field name="code">model._create_recurrent_routes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=0, minute=0, second=0, microsecond=0)"/>
        </record>
    </data>
</odoo>