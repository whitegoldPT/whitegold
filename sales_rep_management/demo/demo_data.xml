<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Demo Sales Representatives -->
        <record id="demo_sales_rep_manager" model="sales.representative">
            <field name="name">John Manager</field>
            <field name="code">REP0001</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="is_manager" eval="True"/>
            <field name="is_supervisor" eval="True"/>
            <field name="monthly_target">50000.0</field>
        </record>

        <record id="demo_sales_rep_supervisor" model="sales.representative">
            <field name="name">Sarah Supervisor</field>
            <field name="code">REP0002</field>
            <field name="user_id" ref="base.user_demo"/>
            <field name="supervisor_id" ref="demo_sales_rep_manager"/>
            <field name="is_supervisor" eval="True"/>
            <field name="monthly_target">30000.0</field>
        </record>

        <record id="demo_sales_rep_1" model="sales.representative">
            <field name="name">Ahmed Ali</field>
            <field name="code">REP0003</field>
            <field name="user_id" ref="base.user_demo"/>
            <field name="supervisor_id" ref="demo_sales_rep_supervisor"/>
            <field name="monthly_target">15000.0</field>
        </record>

        <record id="demo_sales_rep_2" model="sales.representative">
            <field name="name">Mohamed Hassan</field>
            <field name="code">REP0004</field>
            <field name="user_id" ref="base.user_demo"/>
            <field name="supervisor_id" ref="demo_sales_rep_supervisor"/>
            <field name="monthly_target">12000.0</field>
        </record>

        <!-- Demo Customers -->
        <record id="demo_customer_1" model="res.partner">
            <field name="name">Cairo Electronics Store</field>
            <field name="is_company" eval="True"/>
            <field name="customer_rank">1</field>
            <field name="phone">+20 2 12345678</field>
            <field name="email">info@cairoelectronics.com</field>
            <field name="street">123 Tahrir Square</field>
            <field name="city">Cairo</field>
            <field name="country_id" ref="base.eg"/>
        </record>

        <record id="demo_customer_2" model="res.partner">
            <field name="name">Alexandria Tech Hub</field>
            <field name="is_company" eval="True"/>
            <field name="customer_rank">1</field>
            <field name="phone">+20 3 87654321</field>
            <field name="email">contact@alextech.com</field>
            <field name="street">456 Corniche Road</field>
            <field name="city">Alexandria</field>
            <field name="country_id" ref="base.eg"/>
        </record>

        <record id="demo_customer_3" model="res.partner">
            <field name="name">Giza Medical Center</field>
            <field name="is_company" eval="True"/>
            <field name="customer_rank">1</field>
            <field name="phone">+20 2 11223344</field>
            <field name="email">admin@gizamedical.com</field>
            <field name="street">789 Pyramid Street</field>
            <field name="city">Giza</field>
            <field name="country_id" ref="base.eg"/>
        </record>

        <!-- Demo Routes -->
        <record id="demo_route_1" model="sales.rep.route">
            <field name="name">Cairo Downtown Route</field>
            <field name="code">RT20241201-001</field>
            <field name="sales_rep_id" ref="demo_sales_rep_1"/>
            <field name="date" eval="(DateTime.today() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="state">completed</field>
            <field name="sales_target">5000.0</field>
            <field name="collection_target">3000.0</field>
            <field name="start_time" eval="(DateTime.today() - timedelta(days=1)).replace(hour=8, minute=0, second=0)"/>
            <field name="end_time" eval="(DateTime.today() - timedelta(days=1)).replace(hour=17, minute=30, second=0)"/>
        </record>

        <record id="demo_route_2" model="sales.rep.route">
            <field name="name">Alexandria Coastal Route</field>
            <field name="code">RT20241201-002</field>
            <field name="sales_rep_id" ref="demo_sales_rep_2"/>
            <field name="date" eval="DateTime.today().strftime('%Y-%m-%d')"/>
            <field name="state">in_progress</field>
            <field name="sales_target">4000.0</field>
            <field name="collection_target">2500.0</field>
            <field name="start_time" eval="DateTime.today().replace(hour=8, minute=30, second=0)"/>
        </record>

        <!-- Demo Visits -->
        <record id="demo_visit_1" model="sales.rep.visit">
            <field name="name">VST000001</field>
            <field name="route_id" ref="demo_route_1"/>
            <field name="partner_id" ref="demo_customer_1"/>
            <field name="sequence">10</field>
            <field name="visit_type">sales</field>
            <field name="planned_time" eval="(DateTime.today() - timedelta(days=1)).replace(hour=9, minute=0, second=0)"/>
            <field name="visit_time" eval="(DateTime.today() - timedelta(days=1)).replace(hour=9, minute=15, second=0)"/>
            <field name="duration">1.5</field>
            <field name="state">completed</field>
            <field name="visit_result">successful</field>
            <field name="sale_amount">2500.0</field>
            <field name="notes">Customer showed interest in new product line. Discussed volume discounts.</field>
        </record>

        <record id="demo_visit_2" model="sales.rep.visit">
            <field name="name">VST000002</field>
            <field name="route_id" ref="demo_route_1"/>
            <field name="partner_id" ref="demo_customer_3"/>
            <field name="sequence">20</field>
            <field name="visit_type">collection</field>
            <field name="planned_time" eval="(DateTime.today() - timedelta(days=1)).replace(hour=11, minute=0, second=0)"/>
            <field name="visit_time" eval="(DateTime.today() - timedelta(days=1)).replace(hour=11, minute=30, second=0)"/>
            <field name="duration">0.75</field>
            <field name="state">completed</field>
            <field name="visit_result">successful</field>
            <field name="notes">Collected payment for previous orders. Customer satisfied with service.</field>
        </record>

        <record id="demo_visit_3" model="sales.rep.visit">
            <field name="name">VST000003</field>
            <field name="route_id" ref="demo_route_2"/>
            <field name="partner_id" ref="demo_customer_2"/>
            <field name="sequence">10</field>
            <field name="visit_type">sales</field>
            <field name="planned_time" eval="DateTime.today().replace(hour=10, minute=0, second=0)"/>
            <field name="state">planned</field>
            <field name="notes">Follow-up on quotation sent last week.</field>
        </record>

        <!-- Demo Collections -->
        <record id="demo_collection_1" model="sales.rep.collection">
            <field name="name">COL20241201-001</field>
            <field name="visit_id" ref="demo_visit_2"/>
            <field name="collection_date" eval="(DateTime.today() - timedelta(days=1)).replace(hour=11, minute=45, second=0)"/>
            <field name="amount">1500.0</field>
            <field name="payment_method">cash</field>
            <field name="receipt_number">RCP000001</field>
            <field name="state">confirmed</field>
            <field name="submitted_by" ref="base.user_demo"/>
            <field name="submitted_date" eval="(DateTime.today() - timedelta(days=1)).replace(hour=12, minute=0, second=0)"/>
            <field name="confirmed_by" ref="base.user_admin"/>
            <field name="confirmed_date" eval="(DateTime.today() - timedelta(days=1)).replace(hour=14, minute=0, second=0)"/>
            <field name="notes">Payment received in full for invoice INV/2024/001</field>
        </record>

        <!-- Demo Daily Report -->
        <record id="demo_daily_report_1" model="sales.rep.daily.report">
            <field name="name">DR20241201-001</field>
            <field name="sales_rep_id" ref="demo_sales_rep_1"/>
            <field name="report_date" eval="(DateTime.today() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="route_ids" eval="[(6, 0, [ref('demo_route_1')])]"/>
            <field name="state">approved</field>
            <field name="submitted_by" ref="base.user_demo"/>
            <field name="submitted_date" eval="(DateTime.today() - timedelta(days=1)).replace(hour=18, minute=0, second=0)"/>
            <field name="approved_by" ref="base.user_admin"/>
            <field name="approved_date" eval="DateTime.today().replace(hour=9, minute=0, second=0)"/>
            <field name="summary_notes">Successful day with good customer responses. Completed all planned visits.</field>
            <field name="challenges_faced">Traffic delay in the morning caused 15-minute delay for first visit.</field>
            <field name="next_day_plan">Follow up with Cairo Electronics on their bulk order request.</field>
        </record>

    </data>
</odoo>