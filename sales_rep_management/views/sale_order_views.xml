<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_sales_rep" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sales.rep</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="created_sales_rep_id" string="Sales Rep"/>
                <field name="partner_is_cash" invisible="1"/>
                <field name="is_cash" 
                       widget="boolean_toggle" 
                       readonly="state in ['sale', 'done'] or partner_is_cash"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="domain">['|', ('share', '=', True), ('share', '=', False)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
