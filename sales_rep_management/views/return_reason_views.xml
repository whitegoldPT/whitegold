<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Return Reason Tree View -->
        <record id="view_sales_rep_return_reason_tree" model="ir.ui.view">
            <field name="name">sales.rep.return.reason.tree</field>
            <field name="model">sales.rep.return.reason</field>
            <field name="arch" type="xml">
                <list string="Return Reasons" editable="bottom" multi_edit="1">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Return Reason Action -->
        <record id="action_sales_rep_return_reason" model="ir.actions.act_window">
            <field name="name">Return Reasons</field>
            <field name="res_model">sales.rep.return.reason</field>
            <field name="view_mode">list</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first return reason!
                </p>
                <p>
                    These reasons will be available for selection in the mobile app during product returns.
                </p>
            </field>
        </record>

        <!-- Return Reason Menu Item -->
        <menuitem id="menu_sales_rep_return_reasons"
                  name="Return Reasons"
                  parent="menu_sales_rep_config"
                  action="action_sales_rep_return_reason"
                  sequence="10"/>
    </data>
</odoo>
