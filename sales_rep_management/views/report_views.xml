<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Visit Analysis Report View -->
        <record id="view_visit_analysis_pivot" model="ir.ui.view">
            <field name="name">visit.analysis.pivot</field>
            <field name="model">sales.rep.visit</field>
            <field name="arch" type="xml">
                <pivot string="Visit Analysis">
                    <field name="route_id" type="row"/>
                    <field name="visit_type" type="row"/>
                    <field name="state" type="col"/>
                    <field name="sale_amount" type="measure"/>
                    <field name="total_collected" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_visit_analysis_graph" model="ir.ui.view">
            <field name="name">visit.analysis.graph</field>
            <field name="model">sales.rep.visit</field>
            <field name="arch" type="xml">
                <graph string="Visit Analysis" type="bar">
                    <field name="visit_type"/>
                    <field name="sale_amount" type="measure"/>
                    <field name="total_collected" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Collection Analysis Report View -->
        <record id="view_collection_analysis_pivot" model="ir.ui.view">
            <field name="name">collection.analysis.pivot</field>
            <field name="model">sales.rep.collection</field>
            <field name="arch" type="xml">
                <pivot string="Collection Analysis">
                    <field name="sales_rep_id" type="row"/>
                    <field name="payment_method" type="row"/>
                    <field name="state" type="col"/>
                    <field name="amount" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_collection_analysis_graph" model="ir.ui.view">
            <field name="name">collection.analysis.graph</field>
            <field name="model">sales.rep.collection</field>
            <field name="arch" type="xml">
                <graph string="Collection Analysis" type="pie">
                    <field name="payment_method"/>
                    <field name="amount" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Visit Analysis Action -->
        <record id="action_visit_analysis" model="ir.actions.act_window">
            <field name="name">Visit Analysis</field>
            <field name="res_model">sales.rep.visit</field>
            <field name="view_mode">pivot,graph</field>
            <field name="context">{'search_default_completed': 1}</field>
        </record>

        <!-- Collection Analysis Action -->
        <record id="action_collection_analysis" model="ir.actions.act_window">
            <field name="name">Collection Analysis</field>
            <field name="res_model">sales.rep.collection</field>
            <field name="view_mode">pivot,graph</field>
            <field name="context">{'search_default_confirmed': 1}</field>
        </record>

    </data>
</odoo>