<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Sales Orders from Routes - Tree View -->
        <record id="view_sales_rep_sales_orders_tree" model="ir.ui.view">
            <field name="name">sales.rep.sales.orders.tree</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <list string="Route Sales Orders" decoration-info="state=='draft'" decoration-warning="state=='sent'" decoration-success="state=='sale'" decoration-muted="state=='cancel'">
                    <field name="name"/>
                    <field name="route_id"/>
                    <field name="route_customer_id"/>
                    <field name="partner_id"/>
                    <field name="date_order"/>
                    <field name="amount_total" sum="Total Amount"/>
                    <field name="state" widget="badge"/>
                    <field name="invoice_status"/>
                </list>
            </field>
        </record>

        <!-- Sales Orders from Routes - Search View -->
        <record id="view_sales_rep_sales_orders_search" model="ir.ui.view">
            <field name="name">sales.rep.sales.orders.search</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <search string="Route Sales Orders">
                    <field name="name" string="Order"/>
                    <field name="route_id"/>
                    <field name="route_customer_id"/>
                    <field name="partner_id"/>
                    <field name="date_order"/>
                    <separator/>
                    <filter string="Today" name="today" domain="[('date_order', '>=', context_today().strftime('%Y-%m-%d 00:00:00')), ('date_order', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="This Week" name="this_week" domain="[('date_order', '>=', context_today().strftime('%Y-%m-01 00:00:00'))]"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Confirmed" name="sale" domain="[('state', '=', 'sale')]"/>
                    <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Route" name="group_route" context="{'group_by': 'route_id'}"/>
                        <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'date_order:day'}"/>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Sales Orders from Routes - Action -->
        <record id="action_sales_rep_sales_orders" model="ir.actions.act_window">
            <field name="name">Route Sales Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_sales_rep_sales_orders_tree"/>
            <field name="search_view_id" ref="view_sales_rep_sales_orders_search"/>
            <field name="domain">[('route_id', '!=', False)]</field>
            <field name="context">{'search_default_this_week': 1, 'create': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Sales Orders from Routes!
                </p>
                <p>
                    This view shows all sales orders created from sales routes.
                    Sales orders are automatically linked when created during customer visits.
                </p>
            </field>
        </record>

        <!-- POS Orders from Routes - Tree View -->
        <record id="view_sales_rep_pos_orders_tree" model="ir.ui.view">
            <field name="name">sales.rep.pos.orders.tree</field>
            <field name="model">pos.order</field>
            <field name="arch" type="xml">
                <list string="Route POS Orders" decoration-info="state=='draft'" decoration-success="state=='paid'" decoration-warning="state=='done'" decoration-muted="state=='cancel'">
                    <field name="name"/>
                    <field name="route_id"/>
                    <field name="route_customer_id"/>
                    <field name="partner_id"/>
                    <field name="date_order"/>
                    <field name="amount_total" sum="Total Amount"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- POS Orders from Routes - Search View -->
        <record id="view_sales_rep_pos_orders_search" model="ir.ui.view">
            <field name="name">sales.rep.pos.orders.search</field>
            <field name="model">pos.order</field>
            <field name="arch" type="xml">
                <search string="Route POS Orders">
                    <field name="name" string="Order"/>
                    <field name="route_id"/>
                    <field name="route_customer_id"/>
                    <field name="partner_id"/>
                    <field name="date_order"/>
                    <separator/>
                    <filter string="Today" name="today" domain="[('date_order', '>=', context_today().strftime('%Y-%m-%d 00:00:00')), ('date_order', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="This Week" name="this_week" domain="[('date_order', '>=', context_today().strftime('%Y-%m-01 00:00:00'))]"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                    <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Route" name="group_route" context="{'group_by': 'route_id'}"/>
                        <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'date_order:day'}"/>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- POS Orders from Routes - Action -->
        <record id="action_sales_rep_pos_orders" model="ir.actions.act_window">
            <field name="name">Route POS Orders</field>
            <field name="res_model">pos.order</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_sales_rep_pos_orders_tree"/>
            <field name="search_view_id" ref="view_sales_rep_pos_orders_search"/>
            <field name="domain">[('route_id', '!=', False)]</field>
            <field name="context">{'search_default_this_week': 1, 'create': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No POS Orders from Routes!
                </p>
                <p>
                    This view shows all POS orders created from sales routes.
                    POS orders are automatically linked when created during customer visits.
                </p>
            </field>
        </record>

        <!-- Payments from Routes - Tree View -->
        <record id="view_sales_rep_payments_tree" model="ir.ui.view">
            <field name="name">sales.rep.payments.tree</field>
            <field name="model">account.payment</field>
            <field name="arch" type="xml">
                <list string="Route Payments" decoration-info="state=='draft'" decoration-warning="state=='posted'" decoration-success="state=='reconciled'" decoration-muted="state=='cancelled'">
                    <field name="name"/>
                    <field name="route_id"/>
                    <field name="route_customer_id"/>
                    <field name="partner_id"/>
                    <field name="payment_type"/>
                    <field name="amount" sum="Total Amount"/>
                    <field name="date"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Payments from Routes - Search View -->
        <record id="view_sales_rep_payments_search" model="ir.ui.view">
            <field name="name">sales.rep.payments.search</field>
            <field name="model">account.payment</field>
            <field name="arch" type="xml">
                <search string="Route Payments">
                    <field name="name" string="Payment"/>
                    <field name="route_id"/>
                    <field name="route_customer_id"/>
                    <field name="partner_id"/>
                    <field name="date"/>
                    <field name="payment_type"/>
                    <separator/>
                    <filter string="Today" name="today" domain="[('date', '=', context_today())]"/>
                    <filter string="This Week" name="this_week" domain="[('date', '>=', context_today().strftime('%Y-%m-01'))]"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                    <filter string="Reconciled" name="reconciled" domain="[('state', '=', 'reconciled')]"/>
                    <separator/>
                    <filter string="Inbound" name="inbound" domain="[('payment_type', '=', 'inbound')]"/>
                    <filter string="Outbound" name="outbound" domain="[('payment_type', '=', 'outbound')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Route" name="group_route" context="{'group_by': 'route_id'}"/>
                        <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'date:day'}"/>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Payment Type" name="group_payment_type" context="{'group_by': 'payment_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Payments from Routes - Action -->
        <record id="action_sales_rep_payments" model="ir.actions.act_window">
            <field name="name">Route Payments</field>
            <field name="res_model">account.payment</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_sales_rep_payments_tree"/>
            <field name="search_view_id" ref="view_sales_rep_payments_search"/>
            <field name="domain">[('route_id', '!=', False)]</field>
            <field name="context">{'search_default_this_week': 1, 'create': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Payments from Routes!
                </p>
                <p>
                    This view shows all payments collected from sales routes.
                    Payments are automatically linked when created during customer visits.
                </p>
            </field>
        </record>

    </data>
</odoo>