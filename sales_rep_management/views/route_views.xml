<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Sales Rep Route Tree View -->
        <record id="view_sales_rep_route_tree" model="ir.ui.view">
            <field name="name">sales.rep.route.tree</field>
            <field name="model">sales.rep.route</field>
            <field name="arch" type="xml">
                <list string="Sales Routes" decoration-info="state=='draft'" decoration-warning="state=='approved'" decoration-success="state=='completed'">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="sales_rep_id"/>
                    <field name="supervisor_id"/>
                    <field name="date"/>
                    <field name="planned_visits"/>
                    <field name="completed_visits"/>
                    <field name="completion_rate" widget="percentage"/>
                    <field name="sales_target"/>
                    <field name="actual_sales"/>
                    <field name="collection_target"/>
                    <field name="actual_collections"/>
                    <field name="state" widget="badge" decoration-info="state=='draft'" decoration-warning="state=='approved'" decoration-primary="state=='in_progress'" decoration-success="state=='completed'" decoration-muted="state=='cancelled'"/>
                </list>
            </field>
        </record>

        <!-- Sales Rep Route Form View -->
        <record id="view_sales_rep_route_form" model="ir.ui.view">
            <field name="name">sales.rep.route.form</field>
            <field name="model">sales.rep.route</field>
            <field name="arch" type="xml">
                <form string="Sales Route">
                    <header>
                        <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'draft'" groups="sales_rep_management.group_sales_supervisor"/>
                        <button name="action_start" type="object" string="Start Route" class="oe_highlight" invisible="state != 'approved'"/>
                        <button name="action_complete" type="object" string="Complete Route" class="oe_highlight" invisible="state != 'in_progress'"/>
                        <button name="action_cancel" type="object" string="Cancel" invisible="state not in ['draft', 'approved']"/>
                        <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'" groups="sales_rep_management.group_sales_supervisor"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,approved,in_progress,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_visits" type="object" class="oe_stat_button" icon="fa-list">
                                <div class="o_stat_info">
                                    <field name="completed_visits" class="o_stat_value"/>
                                    <span class="o_stat_text">/ <field name="planned_visits"/> Visits</span>
                                </div>
                            </button>
                            <button name="action_view_collections" type="object" class="oe_stat_button" icon="fa-money">
                                <field name="actual_collections" widget="monetary" class="o_stat_value"/>
                                <span class="o_stat_text">Collections</span>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                            <h2>
                                <field name="code" readonly="0"/>
                            </h2>
                        </div>
                        <group>
                            <group name="basic_info">
                                <field name="sales_rep_id" required="1"/>
                                <field name="supervisor_id" readonly="1"/>
                                <field name="date" required="1"/>
                            </group>
                            <group name="timing">
                                <field name="start_time"/>
                                <field name="end_time" readonly="1"/>
                                <field name="completion_rate" widget="percentage"/>
                            </group>
                        </group>
                        <group name="recurrence" string="Recurrence">
                            <field name="is_recurrent"/>
                            <field name="repeat_interval" invisible="is_recurrent == False"/>
                            <field name="repeat_unit" invisible="is_recurrent == False"/>
                            <field name="end_condition" invisible="not is_recurrent"/>
                            <field name="reccurent_hour" widget="recurrent_time_picker" invisible="not is_recurrent"/>
                            <field name="until_date" invisible="not is_recurrent or end_condition != 'until'"/>
                        </group>
                        <group name="targets">
                            <group string="Targets">
                                <field name="sales_target"/>
                                <field name="collection_target"/>
                            </group>
                            <group string="Actuals">
                                <field name="actual_sales"/>
                                <field name="actual_collections"/>
                            </group>
                        </group>
                        <notebook>
                            <!-- New Customers Page -->
                            <page string="Customers" name="customers">
                                <!-- <div class="oe_button_box">
                                    <button name="action_add_customer" type="object" string="Add Customer" class="btn-primary"/>
                                </div> -->
                                <field name="route_customer_ids">
                                    <list editable="bottom" decoration-info="state=='planned'" decoration-warning="state=='in_progress'" decoration-success="state=='visited'" decoration-muted="state=='cancelled'">
                                        <field name="sequence" widget="handle"/>
                                        <field name="partner_id" required="1"/>
                                        <field name="state" widget="badge" readonly="1"/>
                                        <field name="visit_type_id"/>
                                        <field name="visit_id" string="Linked Visit" readonly="1"/>
                                        <field name="visit_start_time" readonly="1"/>
                                        <field name="visit_end_time" readonly="1"/>
                                        <field name="visit_duration" readonly="1"/>
                                        <field name="visit_result" readonly="1"/>
                                        <!-- Start Visit Button - Only visible when planned -->
                                        <button name="action_start_visit" type="object" string="Start Visit" invisible="state not in ['planned', 'visited']" class="btn-primary" title="Start customer visit"/>

                                        <!-- Action Buttons - Only visible when visit in progress -->
                                        <button name="action_end_visit" type="object" string="End Visit" invisible="state != 'in_progress'" class="btn-success" title="End customer visit"/>
                                        <button name="action_create_sale_order" type="object" string="SO" invisible="state != 'in_progress'" class="btn-info" title="Create Sales Order"/>
                                        <button name="action_create_pos_order" type="object" string="POS" invisible="state != 'in_progress'" class="btn-warning" title="Create POS Order"/>
                                        <button name="action_create_payment" type="object" string="Payment" invisible="state != 'in_progress'" class="btn-secondary" title="Create Payment"/>

                                        <!-- Orders Button - Always visible -->
                                        <button name="action_view_related_orders" type="object" string="Orders" class="btn-default" title="View Related Orders"/>
                                    </list>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="partner_id" required="1"/>
                                                <field name="sequence"/>
                                                <field name="state"/>
                                                <field name="visit_id" string="Linked Visit" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="visit_start_time" readonly="1"/>
                                                <field name="visit_end_time" readonly="1"/>
                                                <field name="visit_duration" readonly="1"/>
                                                <field name="visit_result"/>
                                            </group>
                                        </group>
                                        <field name="visit_notes" placeholder="Visit notes and observations..."/>
                                    </form>
                                </field>
                            </page>

                            <!-- New Sales Orders Page -->
                            <page string="Sales Orders" name="sales_orders">
                                <field name="sale_order_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="date_order"/>
                                        <field name="amount_total"/>
                                        <field name="state" widget="badge"/>
                                        <field name="invoice_status"/>
                                    </list>
                                </field>
                            </page>

                            <!-- New POS Orders Page -->
                            <page string="POS Orders" name="pos_orders">
                                <field name="pos_order_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="date_order"/>
                                        <field name="amount_total"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>

                            <!-- New Payments Page -->
                            <page string="Payments" name="payments">
                                <field name="payment_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="payment_type"/>
                                        <field name="amount"/>
                                        <field name="date"/>
                                        <field name="state" widget="badge"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Visits" name="visits">
                                <field name="visit_ids" readonly="1" context="{'default_route_id': id}">
                                    <list editable="bottom" decoration-info="state=='planned'" decoration-warning="state=='in_progress'" decoration-success="state=='completed'" decoration-muted="state=='cancelled'">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="partner_id" required="1"/>
                                        <field name="visit_type"/>
                                        <field name="planned_time"/>
                                        <field name="visit_time"/>
                                        <field name="visit_result"/>
                                        <field name="sale_amount" sum="Total Sales"/>
                                        <field name="total_collected" sum="Total Collections"/>
                                        <field name="state" widget="badge"/>
                                        <!--<button name="action_start_visit" type="object" string="Start" invisible="state != 'planned'" class="btn-primary"/>-->
                                        <!--<button name="action_complete_visit" type="object" string="Complete" invisible="state != 'in_progress'" class="btn-success"/>-->
                                    </list>
                                </field>
                                <div class="oe_clear"/>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="planned_visits" string="Planned Visits"/>
                                    <field name="completed_visits" string="Completed Visits"/>
                                    <field name="completion_rate" widget="percentage" string="Completion Rate"/>
                                </group>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes" placeholder="Route notes and comments..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Sales Rep Route Kanban View -->
        <record id="view_sales_rep_route_kanban" model="ir.ui.view">
            <field name="name">sales.rep.route.kanban</field>
            <field name="model">sales.rep.route</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="sales_rep_id"/>
                    <field name="date"/>
                    <field name="planned_visits"/>
                    <field name="completed_visits"/>
                    <field name="completion_rate"/>
                    <field name="actual_sales"/>
                    <field name="actual_collections"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_card_header">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary">
                                            <strong><field name="name"/></strong>
                                        </div>
                                        <div class="o_secondary">
                                            <field name="code"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_card_content">
                                    <div class="container">
                                        <div class="row">
                                            <div class="col-12">
                                                <strong><field name="sales_rep_id"/></strong>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12">
                                                <i class="fa fa-calendar"/> <field name="date"/>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-6">
                                                <div class="text-muted">Visits</div>
                                                <div><field name="completed_visits"/>/<field name="planned_visits"/></div>
                                            </div>
                                            <div class="col-6">
                                                <div class="text-muted">Progress</div>
                                                <div><field name="completion_rate" widget="percentage"/></div>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-6">
                                                <div class="text-muted">Sales</div>
                                                <div>$<field name="actual_sales"/></div>
                                            </div>
                                            <div class="col-6">
                                                <div class="text-muted">Collections</div>
                                                <div>$<field name="actual_collections"/></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_card_manage_pane">
                                    <a role="button" type="edit" class="btn btn-sm btn-secondary">Edit</a>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Sales Rep Route Search View -->
        <record id="view_sales_rep_route_search" model="ir.ui.view">
            <field name="name">sales.rep.route.search</field>
            <field name="model">sales.rep.route</field>
            <field name="arch" type="xml">
                <search string="Sales Routes">
                    <field name="name" string="Route" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <field name="sales_rep_id"/>
                    <field name="supervisor_id"/>
                    <field name="date"/>
                    <separator/>
                    <filter string="Today" name="today"/>
                    <filter string="This Week" name="this_week"/>
                    <filter string="This Month" name="this_month"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Sales Rep" name="group_sales_rep" context="{'group_by': 'sales_rep_id'}"/>
                        <filter string="Supervisor" name="group_supervisor" context="{'group_by': 'supervisor_id'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Sales Rep Route Action -->
        <record id="action_sales_rep_route" model="ir.actions.act_window">
            <field name="name">Sales Routes</field>
            <field name="res_model">sales.rep.route</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_sales_rep_route_search"/>
            <field name="context">{'search_default_this_week': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Sales Route!
                </p>
                <p>
                    Sales routes define the daily plan for your sales representatives.
                    Create routes with planned visits, set targets, and track progress.
                </p>
            </field>
        </record>

    </data>
</odoo>