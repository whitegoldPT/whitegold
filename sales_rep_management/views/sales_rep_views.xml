<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Sales Representative Tree View -->
        <record id="view_sales_representative_tree" model="ir.ui.view">
            <field name="name">sales.representative.tree</field>
            <field name="model">sales.representative</field>
            <field name="arch" type="xml">
                <list string="Sales Representatives">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="supervisor_id"/>
                    <field name="is_supervisor"/>
                    <field name="is_manager"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="total_routes"/>
                    <field name="total_visits"/>
                    <field name="total_collections" sum="Total Collections"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Sales Representative Form View -->
        <record id="view_sales_representative_form" model="ir.ui.view">
            <field name="name">sales.representative.form</field>
            <field name="model">sales.representative</field>
            <field name="arch" type="xml">
                <form string="Sales Representative">
                    <header>
                        <field name="active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_routes" type="object" class="oe_stat_button" icon="fa-route">
                                <field name="total_routes" widget="statinfo" string="Routes"/>
                            </button>
                            <button name="action_view_visits" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="total_visits" widget="statinfo" string="Visits"/>
                            </button>
                            <button name="action_view_collections" type="object" class="oe_stat_button" icon="fa-money">
                                <field name="total_collections" widget="monetary" string="Collections"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                            <h2>
                                <field name="code" readonly="1"/>
                            </h2>
                        </div>
                        <group>
                            <group name="basic_info">
                                <field name="company_id" invisible="1"/>
                                <field name="user_id" required="1"/>
                                <field name="employee_id"/>
                                <field name="supervisor_id" domain="[('is_supervisor', '=', True)]"/>
                                <field name="crm_team_id"/>
                                <field name="is_supervisor"/>
                                <field name="is_manager"/>
                                <field name="is_driver" invisible="1"/>
                            </group>
                            <group name="contact_info">
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="monthly_target"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Territories" name="territories">
                                <field name="territory_ids" widget="many2many_tags"/>
                            </page>
                            <page string="Team Members" name="team_members" invisible="not is_supervisor">
                              <field name="team_member_ids" string="Team Members" widget="many2many_tags" domain="[('is_supervisor', '=', False), ('is_manager', '=', False), ('supervisor_id', '=', False)]">
                                 <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <field name="phone"/>
                                    <field name="total_routes"/>
                                    <field name="total_collections"/>
                                    <field name="active"/>
                                </list>
                              </field>
                            </page>
                            <page string="Driver License" name="driver_license_page" invisible="is_driver == False">
                                <div class="alert alert-info" role="alert"> This is a read-only copy of the license information from the employee's record. </div>
                                <group>
                                    <group string="License Details">
                                        <field name="license_number"/>
                                        <field name="license_issue_date"/>
                                        <field name="license_expiry_date"/>
                                    </group>
                                    <group string="Attachments">
                                        <field name="license_attachment" widget="binary" filename="driver_license_attachment_filename"/>
                                        <div class="o_row">
                                        <button name="action_view_license_attachment" type="object" icon="fa-eye" string="View" class="btn btn-secondary" invisible="license_attachment == False"/>
                                        </div>
                                    </group>
                                </group>

<!--                                <group string="Expiration Notification Settings" readonly="1">-->
<!--                                    <field name="get_notify"/>-->
<!--                                    <label for="notify_before_days" invisible="get_notify == False"/>-->
<!--                                    <div class="o_row" invisible="get_notify == False">-->
<!--                                        <field name="notify_before_days"/>-->
<!--                                        <span>days</span>-->
<!--                                    </div>-->
<!--                                    <field name="notification_type" invisible="get_notify == False"/>-->
<!--                                    <field name="notification_recipient_ids" widget="many2many_tags" invisible="get_notify == False"/>-->
<!--                                </group> -->
                            </page>
                            <page string="Accounting" name="accounting">
                                <group>
                                    <group string="Journals &amp; Taxes">
                                        <field name="invoice_journal_id"/>
                                        <field name="fiscal_position_id"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Inventory" name="inventory">
                                <group>
                                    <group string="Stock">
                                        <!-- <field name="picking_type_id"/> -->
                                        <!-- <field name="stock_location_id"/> -->
                                        <field name="default_location_id"/> 
                                        <field name="return_location_id"/>
                                    </group>
                                    <group string="Settings">
                                        <field name="auto_delivery"/>
                                        <field name="auto_receive"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Products" name="products">
                                <group>
<!--                                     <group string="Pricing">
                                         <field name="default_pricelist_id"/>
                                         <field name="available_pricelist_ids" widget="many2many_tags"/>
                                     </group> -->
                                    <group string="Categories">
                                        <field name="product_category_ids" widget="many2many_tags"
                                               placeholder="All categories if empty"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Payment Methods" name="payments">
                                <group>
                                    <field name="payment_method_ids" widget="many2many_tags"
                                           placeholder="Select payment methods..."/>
                                </group>
                            </page>
                            <page string="Pricing &amp; Policies" name="pricing_policies">
                            <group>
                                <group string="Pricing" name="pricing_group">
                                    <field name="default_pricelist_id" options="{'no_create': True}"/>
                                </group>
                                <group string="Policies" name="policies_group">
                                    <field name="payment_term_id" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>


                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Sales Representative Kanban View -->
        <record id="view_sales_representative_kanban" model="ir.ui.view">
            <field name="name">sales.representative.kanban</field>
            <field name="model">sales.representative</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="supervisor_id"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="total_routes"/>
                    <field name="total_visits"/>
                    <field name="total_collections"/>
                    <field name="monthly_target"/>
                    <field name="is_supervisor"/>
                    <field name="is_manager"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_card_header">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary">
                                            <strong><field name="name"/></strong>
                                        </div>
                                        <div class="o_secondary">
                                            <field name="code"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_card_content">
                                    <div class="o_kanban_card_manage_pane">
                                        <div class="row">
                                            <div class="col-6 o_kanban_primary_left">
                                                <div t-if="record.is_supervisor.raw_value" class="badge badge-pill badge-info">Supervisor</div>
                                                <div t-if="record.is_manager.raw_value" class="badge badge-pill badge-success">Manager</div>
                                            </div>
                                            <div class="col-6 o_kanban_primary_right">
                                                <div class="mb4">
                                                    <field name="user_id" widget="many2one_avatar_user"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12">
                                                <div><i class="fa fa-phone"/> <field name="phone"/></div>
                                                <div><i class="fa fa-envelope"/> <field name="email"/></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="container o_kanban_card_content o_visible">
                                        <div class="row">
                                            <div class="col-4">
                                                <button type="object" name="action_view_routes" class="btn btn-primary btn-sm">
                                                    <field name="total_routes"/> Routes
                                                </button>
                                            </div>
                                            <div class="col-4">
                                                <button type="object" name="action_view_visits" class="btn btn-info btn-sm">
                                                    <field name="total_visits"/> Visits
                                                </button>
                                            </div>
                                            <div class="col-4">
                                                <button type="object" name="action_view_collections" class="btn btn-success btn-sm">
                                                    $<field name="total_collections"/>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="row mt-2" t-if="record.monthly_target.raw_value">
                                            <div class="col-12">
                                                <div class="text-muted">Monthly Target: $<field name="monthly_target"/></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Sales Representative Search View -->
        <record id="view_sales_representative_search" model="ir.ui.view">
            <field name="name">sales.representative.search</field>
            <field name="model">sales.representative</field>
            <field name="arch" type="xml">
                <search string="Sales Representatives">
                    <field name="name" string="Representative" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                    <field name="user_id"/>
                    <field name="supervisor_id"/>
                    <separator/>
                    <filter string="Active" name="active"/>
                    <filter string="Inactive" name="inactive"/>
                    <separator/>
                    <filter string="Supervisors" name="supervisors"/>
                    <filter string="Managers" name="managers"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Supervisor" name="group_supervisor" context="{'group_by': 'supervisor_id'}"/>
                        <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Sales Representative Action -->
        <record id="action_sales_representative" model="ir.actions.act_window">
            <field name="name">Sales Representatives</field>
            <field name="res_model">sales.representative</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_sales_representative_search"/>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Sales Representative!
                </p>
                <p>
                    Sales representatives are the backbone of your sales operations. They execute routes,
                    visit customers, make sales, and collect payments. Set up your sales team here.
                </p>
            </field>
        </record>

    </data>
</odoo>