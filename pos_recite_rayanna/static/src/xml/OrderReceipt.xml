<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_recite_rayanna.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-receipt')]" position="replace">
            <div class="pos-receipt">
                <!-- Header: Logo and Branch -->
                <div class="pos-receipt-header">
                    <t t-if="props.data.headerData.company.id">
                        <img class="pos-receipt-logo" t-att-src="'/web/image?model=res.company&amp;id=' + props.data.headerData.company.id + '&amp;field=logo'" alt="Logo"/>
                    </t>
                    <div class="receipt-branch-name"><t t-esc="props.data.headerData.company.name"/></div>
                </div>

                <!-- Order Number -->
                <div class="text-center">
                    <div class="receipt-order-number">
                        <t t-esc="props.data.name.split('-').pop() || props.data.name"/>
                    </div>
                </div>

                <!-- Date, Time, Cashier Info -->
                <div class="receipt-info-section">
                    <div class="receipt-info-row">
                        <span class="receipt-info-label">الوقت</span>
                        <span>
                            <t t-esc="englishDate"/>
                        </span>
                    </div>
                    <div class="receipt-info-row">
                        <span class="receipt-info-label">الكاشير</span>
                        <span><t t-esc="props.data.cashier"/></span>
                    </div>
                </div>

                <!-- Orderlines Table -->
                <table class="receipt-table">
                    <thead>
                        <tr>
                            <th class="text-right" style="width: 12%;">الكمية</th>
                            <th class="text-right" style="width: 48%;">الصنف</th>
                            <th class="text-center" style="width: 15%;">السعر</th>
                            <t t-if="hasAnyDiscount">
                                <th class="text-center" style="width: 12%;">الخصم</th>
                            </t>
                            <th class="text-left" style="width: 13%;">الاجمالي</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="processedLines" t-as="line" t-key="line._key">
                            <tr>
                                <td class="text-right">
                                    <t t-esc="line.quantity || line.qty"/>
                                </td>
                                <td class="text-right">
                                    <div class="item-name">
                                        <t t-esc="line.productName || line.product_name || line.full_product_name"/>
                                    </div>
                                    <t t-if="line.customer_note">
                                        <div class="item-details"><t t-esc="line.customer_note"/></div>
                                    </t>
                                </td>
                                <td class="text-center">
                                    <t t-esc="props.formatCurrency(line.price_without_discount, false)"/>
                                </td>
                                <t t-if="hasAnyDiscount">
                                    <td class="text-center">
                                        <t t-if="line.discount &gt; 0">
                                            <t t-esc="props.formatCurrency(line.discount, false)"/>
                                        </t>
                                        <t t-else="">--</t>
                                    </td>
                                </t>
                                <td class="text-left">
                                    <t t-esc="props.formatCurrency(line.price_num, false)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Totals Section -->
                <div class="totals-section">
                    <div class="total-row">
                        <span class="receipt-info-label">اجمالى الاصناف</span>
                        <t t-esc="props.formatCurrency((props.data.amount_total || 0) + (props.data.total_discount || 0))"/>
                    </div>
                   
                    <t t-if="props.data.total_discount">
                        <div class="total-row">
                            <span class="receipt-info-label">الخصم</span>
                            <t t-esc="props.formatCurrency(props.data.total_discount)"/>
                        </div>
                    </t>
                     <div class="total-row grand-total">
                        <span class="receipt-info-label">الاجمالى</span>
                        <t t-esc="props.formatCurrency(props.data.amount_total || props.data.total_with_tax || 0)"/>
                    </div>
                    <!-- <div class="total-row grand-total">
                        <span class="receipt-info-label">الاجمالى</span>
                        <t t-esc="props.formatCurrency(props.data.amount_total || props.data.total_with_tax)"/>
                    </div> -->
                    <div class="total-row">
                        <span class="receipt-info-label">المدفوع</span>
                        <t t-esc="props.formatCurrency((props.data.amount_total || props.data.total_with_tax || 0) + (props.data.change || 0))"/>
                    </div>
                    <t t-if="props.data.change">
                        <div class="total-row">
                            <span class="receipt-info-label">الباقي</span>
                            <t t-esc="props.formatCurrency(props.data.change || 0)"/>
                        </div>
                    </t>
                </div>

                <!-- Payment Methods -->
                <div class="payment-section">
                    <t t-foreach="props.data.paymentlines" t-as="line" t-key="line.cid || line.id || line_index">
                        <div class="total-row">
                            <span><t t-esc="line.name"/></span>
                            <span><t t-esc="props.formatCurrency(line.amount)"/></span>
                        </div>
                    </t>
                </div>

                <!-- Footer -->
                <div class="receipt-footer">
                    <div class="text-center">
                        <span class="font-size-normal"><t t-esc="props.data.partner?.name"/></span>
                    </div>
                    <div class="receipt-address">
                        <t t-if="props.data.headerData.company.street"><t t-esc="props.data.headerData.company.street"/> </t>
                        <t t-if="props.data.headerData.company.city"><t t-esc="props.data.headerData.company.city"/></t>
                        <t t-if="props.data.headerData.company.phone">
                            <div class="receipt-phone">ت: <t t-esc="props.data.headerData.company.phone"/></div>
                        </t>
                    </div>
                        
                    <div class="hotline-badge">15606</div>

                    <div class="qr-code-container">
                        <img src="/pos_recite_rayanna/static/src/img/qrcode.png" style="width: 100%; height: 100%;"/>
                    </div>

                    <div class="social-media-text">تابعونا على منصات السوشيال ميديا</div>

                    <div class="receipt-number-footer">
                        <t t-esc="props.data.name"/>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
