<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job: The Invisible Inspector (Forensic Audit Engine) -->
        <record id="ir_cron_automated_forensic_scan" model="ir.cron">
            <field name="name">Forensic Engine: Nightly Automated Audit</field>
            <field name="model_id" ref="account.model_account_move_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_automated_forensic_scan()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
