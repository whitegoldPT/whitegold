<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_line_audit_tree" model="ir.ui.view">
            <field name="name">account.move.line.audit.list</field>
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
                <list string="🛡️ Forensic Audit Control Center" 
                      multi_edit="1" create="0" edit="1"
                      decoration-danger="risk_level in ('critical', 'high')"
                      decoration-warning="risk_level == 'medium'"
                      decoration-info="audit_status == 'fixed'"
                      default_order="risk_score desc">
                    <field name="risk_level" widget="badge" 
                           decoration-danger="risk_level in ('critical', 'high')"
                           decoration-warning="risk_level == 'medium'"
                           decoration-success="risk_level == 'low'"
                           invisible="not diagnostic_reason"/>
                    <field name="date" readonly="1"/>
                    <field name="move_id" readonly="1" widget="many2one_clickable"/>
                    <field name="account_id" readonly="1"/>
                    <field name="partner_id" widget="many2one_avatar"/>
                    
                    <!-- Core Diagnosis Columns -->
                    <field name="diagnostic_reason" decoration-bf="1" string="🔴 Detected Anomaly (سبب الخطأ)" invisible="not diagnostic_reason"/>
                    <field name="suggested_action" decoration-it="1" string="🔧 Correction (طريقة التصليح)" invisible="not diagnostic_reason"/>
                    
                    <field name="debit" sum="Total Debit" readonly="1" optional="show"/>
                    <field name="credit" sum="Total Credit" readonly="1" optional="show"/>
                    <field name="audit_status" widget="badge" 
                           decoration-success="audit_status == 'approved'"
                           decoration-info="audit_status == 'fixed'"
                           decoration-muted="audit_status == 'pending'"
                           invisible="not diagnostic_reason"/>
                    
                    <!-- Action Buttons -->
                    <button name="action_smart_fix" string="Smart Fix" type="object" 
                            icon="fa-wrench" class="btn-primary" 
                            title="Execute professional correction strategy"
                            invisible="not diagnostic_reason or audit_status in ('approved', 'fixed')"/>
                    <button name="action_refresh_line_diagnosis" string="Re-Scan" type="object" 
                            icon="fa-refresh" title="Refresh local diagnosis"
                            invisible="not diagnostic_reason"/>
                    <button name="action_mark_as_fixed" string="Quick Done" type="object" 
                            icon="fa-check" class="text-success"
                            invisible="not diagnostic_reason or audit_status == 'fixed'"/>
                </list>
            </field>
        </record>

        <record id="view_move_line_audit_graph" model="ir.ui.view">
            <field name="name">account.move.line.audit.graph</field>
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
                <graph string="Audit Analysis" type="bar">
                    <field name="audit_status"/>
                    <field name="debit" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_move_line_audit_search" model="ir.ui.view">
            <field name="name">account.move.line.audit.search</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_account_move_line_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='unreconciled']" position="after">
                    <separator/>
                    <filter string="⚠️ Scattered Items" name="audit_issues" domain="[('diagnostic_reason', '!=', False)]"/>
                </xpath>
            </field>
        </record>

        <!-- New Forensic Invoice View for account.move -->
        <record id="view_move_forensic_list" model="ir.ui.view">
            <field name="name">account.move.forensic.list</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list string="🛡️ Forensic Invoice Audit" decoration-danger="risk_score &gt; 80" decoration-warning="risk_score &gt; 0">
                    <field name="name" string="رقم الفاتورة"/>
                    <field name="invoice_origin" string="المستند الأصلي"/>
                    <field name="partner_id"/>
                    <field name="invoice_date" string="التاريخ"/>
                    <field name="amount_total" sum="Total"/>
                    <field name="risk_score" widget="priority" string="مستوى الخطر"/>
                    <field name="payment_state" widget="badge" decoration-success="payment_state == 'paid'"/>
                    <field name="state" invisible="1"/>
                </list>
            </field>
        </record>

        <record id="action_audit_cleanup_center" model="ir.actions.act_window">
            <field name="name">Financial Cleanup Center</field>
            <field name="res_model">account.move.line</field>
            <field name="view_mode">list,graph,form</field>
            <field name="view_id" ref="view_move_line_audit_tree"/>
            <field name="search_view_id" ref="view_move_line_audit_search"/>
            <field name="context">{'search_default_audit_issues': 1}</field>
        </record>

        <menuitem id="menu_audit_cleanup_root" name="Financial Cleanup" parent="account.menu_finance_reports" sequence="50" action="action_audit_cleanup_center"/>
    </data>
</odoo>
