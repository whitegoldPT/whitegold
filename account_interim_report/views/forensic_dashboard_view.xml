<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forensic_dashboard_form" model="ir.ui.view">
        <field name="name">forensic.dashboard.form</field>
        <field name="model">forensic.dashboard</field>
        <field name="arch" type="xml">
            <form string="رادار الرقابة الجنائية" create="0" edit="0" class="o_forensic_dashboard">
                <header>
                    <button name="action_run_deep_scan" string="🚀 فحص جنائي شامل (Turbo Scan)" type="object" class="btn-danger btn-lg p-3" icon="fa-bolt" style="font-weight: bold; border-radius: 30px; box-shadow: 0 4px 15px rgba(220, 53, 69, 0.4);"/>
                </header>
                <sheet>
                    <style>
                        .o_forensic_dashboard .o_sheet { 
                            background: #f0f2f5 !important; 
                        }
                        .fd_header {
                            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
                            padding: 40px;
                            border-radius: 20px;
                            color: white;
                            margin-bottom: 30px;
                            box-shadow: 0 10px 30px rgba(30, 60, 114, 0.2);
                        }
                        .fd_card {
                            background: white;
                            border-radius: 18px;
                            padding: 25px;
                            border: 1px solid rgba(0,0,0,0.05);
                            transition: all 0.3s ease;
                            height: 100%;
                            display: flex;
                            flex-direction: column;
                            justify-content: center;
                            position: relative;
                            overflow: hidden;
                        }
                        .fd_card:hover {
                            transform: translateY(-8px);
                            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
                        }
                        .fd_card::after {
                            content: '';
                            position: absolute;
                            top: 0; right: 0;
                            width: 100px; height: 100px;
                            background: rgba(0,0,0,0.02);
                            border-radius: 50%;
                            transform: translate(30%, -30%);
                        }
                        .fd_val {
                            font-size: 2.2rem;
                            font-weight: 800;
                            color: #1e3c72;
                            margin: 10px 0;
                        }
                        .fd_label {
                            font-size: 0.95rem;
                            color: #6c757d;
                            font-weight: 600;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                        }
                        .fd_icon_box {
                            width: 50px; height: 50px;
                            border-radius: 12px;
                            display: flex; align-items: center; justify-content: center;
                            font-size: 20px; margin-bottom: 15px;
                        }
                        .bg-glass {
                            background: rgba(255, 255, 255, 0.15);
                            backdrop-filter: blur(10px);
                            border: 1px solid rgba(255,255,255,0.2);
                        }
                        .trust_circle {
                            width: 120px; height: 120px;
                            border-radius: 50%;
                            border: 8px solid rgba(255,255,255,0.2);
                            display: flex; align-items: center; justify-content: center;
                            flex-direction: column;
                            margin: 0 auto;
                        }
                        .heatmap_btn {
                            width: 100%; border: none; background: white; 
                            border-radius: 15px; padding: 20px; 
                            transition: all 0.2s;
                            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
                        }
                        .heatmap_btn:hover {
                            filter: brightness(0.95);
                            transform: scale(1.02);
                        }
                    </style>

                    <div class="fd_header d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h1 style="font-weight: 800; font-size: 2.8rem; margin-bottom: 5px;">رادار النزاهة المالية</h1>
                            <p style="font-size: 1.2rem; opacity: 0.8;">محرك الرقابة الجنائية التلقائي - Odoo 18.0</p>
                            <div class="mt-4 d-flex">
                                <div class="me-4"><i class="fa fa-check-circle me-1"/> تشفير البيانات: نشط</div>
                                <div><i class="fa fa-clock-o me-1"/> فحص تلقائي: يومي (02:00 AM)</div>
                            </div>
                        </div>
                        <div class="text-center" style="width: 250px;">
                            <div class="trust_circle bg-glass">
                                <div style="font-size: 1.8rem; font-weight: 900;"><field name="trust_index"/>%</div>
                                <div style="font-size: 0.7rem; font-weight: bold; opacity: 0.9;">مؤشر الثقة</div>
                            </div>
                            <div class="mt-3 badge bg-success" style="padding: 8px 15px;">نظام مستقر</div>
                        </div>
                    </div>

                    <!-- Row 1: Critical Metrics -->
                    <div class="row">
                        <div class="col-md-3 mb-4">
                            <div class="fd_card" style="border-right: 6px solid #dc3545;">
                                <div class="fd_icon_box" style="background: #fff5f5; color: #dc3545;"><i class="fa fa-exclamation-triangle"/></div>
                                <div class="fd_label">مبالغ مخاطر عالية</div>
                                <div class="fd_val" style="color: #dc3545;"><field name="amount_at_risk" widget="monetary"/></div>
                                <div class="progress mt-2" style="height: 6px;"><div class="progress-bar bg-danger" style="width: 85%"></div></div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-4">
                            <div class="fd_card" style="border-right: 6px solid #fd7e14;">
                                <div class="fd_icon_box" style="background: #fffaf0; color: #fd7e14;"><i class="fa fa-shield"/></div>
                                <div class="fd_label">مخالفات السياسة السيادية</div>
                                <div class="fd_val"><field name="count_high_risk"/></div>
                                <span class="text-muted small">حالات حرجة جداً</span>
                            </div>
                        </div>
                        <div class="col-md-3 mb-4">
                            <div class="fd_card" style="border-right: 6px solid #1e3c72;">
                                <div class="fd_icon_box" style="background: #f0f4ff; color: #1e3c72;"><i class="fa fa-moon-o"/></div>
                                <div class="fd_label">أنشطة منتصف الليل</div>
                                <div class="fd_val"><field name="count_late_night"/></div>
                                <span class="text-muted small">بين 12ص و 5ص</span>
                            </div>
                        </div>
                        <div class="col-md-3 mb-4">
                            <div class="fd_card" style="border-right: 6px solid #28a745;">
                                <div class="fd_icon_box" style="background: #f0fff4; color: #28a745;"><i class="fa fa-dashboard"/></div>
                                <div class="fd_label">سكور التعرض الكلي</div>
                                <div class="fd_val"><field name="total_risk_exposure"/></div>
                                <span class="text-muted small">Total Risk Score</span>
                            </div>
                        </div>
                    </div>

                    <!-- Row 1.5: RNI Metrics -->
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="fd_card" style="border-right: 6px solid #8e44ad; background: #faf5ff;">
                                <div class="fd_icon_box" style="background: #f3e5f5; color: #8e44ad;"><i class="fa fa-truck"/></div>
                                <div class="fd_label">مشتريات معلقة (Received Not Invoiced)</div>
                                <div class="fd_val" style="color: #8e44ad;"><field name="rni_count"/> <span style="font-size: 16px;">أمر شراء</span></div>
                                <span class="text-muted small">طلبات استلمت في المخزن ولم تدخل لها فاتورة</span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="fd_card" style="border-right: 6px solid #e74c3c; background: #fff5f5;">
                                <div class="fd_icon_box" style="background: #fdedec; color: #e74c3c;"><i class="fa fa-money"/></div>
                                <div class="fd_label">إجمالي المبالغ المعلقة بدون فوترة</div>
                                <div class="fd_val" style="color: #e74c3c;"><field name="rni_total_amount" widget="monetary"/></div>
                                <span class="text-muted small">إجمالي قيمة البضاعة التي استلمت ولها التزام مالي مخفي</span>
                            </div>
                        </div>
                    </div>

                    <!-- Section: Sector Analysis -->
                    <div class="mt-4 mb-4" style="background: white; border-radius: 20px; padding: 30px; box-shadow: 0 10px 25px rgba(0,0,0,0.03);">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h3 style="font-weight: 800; color: #2c3e50; margin: 0;"><i class="fa fa-th-large me-2" style="color: #1e3c72;"/> توزيع الأخطاء حسب الأقسام (Heatmap)</h3>
                            <span class="badge bg-light text-dark p-2">انقر على القسم للمراجعة</span>
                        </div>
                        
                        <div class="row g-3">
                            <div class="col-md-2">
                                <button name="action_open_purchase_vouchers" type="object" class="heatmap_btn">
                                    <i class="fa fa-shopping-cart h1 text-danger"/>
                                    <div class="h3 font-weight-bold mb-0 mt-2"><field name="count_purchase"/></div>
                                    <div class="text-muted small font-weight-bold">المشتريات والفوترة</div>
                                </button>
                            </div>
                            <div class="col-md-2">
                                <button name="action_open_rni_center" type="object" class="heatmap_btn" style="border-color: #8e44ad;">
                                    <i class="fa fa-truck h1" style="color: #8e44ad;"/>
                                    <div class="h3 font-weight-bold mb-0 mt-2" style="color: #8e44ad;"><field name="rni_count"/></div>
                                    <div class="text-muted small font-weight-bold">مشتريات معلقة RNI</div>
                                </button>
                            </div>
                            <div class="col-md-2">
                                <button name="action_open_sale_vouchers" type="object" class="heatmap_btn">
                                    <i class="fa fa-line-chart h1 text-warning"/>
                                    <div class="h3 font-weight-bold mb-0 mt-2"><field name="count_sale"/></div>
                                    <div class="text-muted small font-weight-bold">المبيعات</div>
                                </button>
                            </div>
                            <div class="col-md-2">
                                <button name="action_open_stock_transfers" type="object" class="heatmap_btn">
                                    <i class="fa fa-cube h1 text-info"/>
                                    <div class="h3 font-weight-bold mb-0 mt-2"><field name="count_inventory"/></div>
                                    <div class="text-muted small font-weight-bold">المخازن</div>
                                </button>
                            </div>
                            <div class="col-md-2">
                                <button name="action_open_mrp_orders" type="object" class="heatmap_btn">
                                    <i class="fa fa-industry h1 text-secondary"/>
                                    <div class="h3 font-weight-bold mb-0 mt-2"><field name="count_mfg"/></div>
                                    <div class="text-muted small font-weight-bold">التصنيع</div>
                                </button>
                            </div>
                            <div class="col-md-2">
                                <div class="heatmap_btn">
                                    <i class="fa fa-university h1 text-success"/>
                                    <div class="h3 font-weight-bold mb-0 mt-2"><field name="count_general"/></div>
                                    <div class="text-muted small font-weight-bold">القيود العامة</div>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="heatmap_btn" style="background: #1e3c72; color: white;">
                                    <i class="fa fa-list-ol h1 text-white opacity-75"/>
                                    <div class="h3 font-weight-bold mb-0 mt-2 text-white"><field name="count_gaps"/></div>
                                    <div class="text-white small font-weight-bold">فجوات التسلسل</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 3: Offenders -->
                    <div class="row mt-4">
                        <div class="col-md-7 mb-4">
                            <div style="background: white; border-radius: 20px; padding: 25px; height: 100%; box-shadow: 0 4px 15px rgba(0,0,0,0.02);">
                                <h3 class="mb-4" style="font-weight: 700;"><i class="fa fa-users me-2 text-primary"/> الموظفون الأكثر عرضة للمخاطر</h3>
                                <field name="top_offenders_html"/>
                            </div>
                        </div>
                        <div class="col-md-5 mb-4">
                            <div style="background: white; border-radius: 20px; padding: 25px; height: 100%; border: 3px dashed #dee2e6; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                                <i class="fa fa-pie-chart fa-5x text-muted mb-3 opacity-25"/>
                                <h4 class="text-muted">تحليل الأنماط الذكي</h4>
                                <p class="text-muted text-center small px-4">سيتم عرض الرسم البياني التفاعلي لنمط الأخطاء بمجرد اكتمال الفحص الأول لـ 1000 حركة.</p>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_forensic_dashboard_new" model="ir.actions.act_window">
        <field name="name">Risk Dashboard</field>
        <field name="res_model">forensic.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>
</odoo>
