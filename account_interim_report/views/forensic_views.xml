<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Forensic Rule View -->
        <record id="view_forensic_rule_tree" model="ir.ui.view">
            <field name="name">forensic.rule.tree</field>
            <field name="model">forensic.rule</field>
            <field name="arch" type="xml">
                <list string="Forensic Rules">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="category" widget="badge"/>
                    <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'"/>
                    <field name="weight"/>
                    <field name="action_type" widget="badge"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_forensic_rule_form" model="ir.ui.view">
            <field name="name">forensic.rule.form</field>
            <field name="model">forensic.rule</field>
            <field name="arch" type="xml">
                <form string="Forensic Rule">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="e.g. Excessive Discount Check"/></h1>
                        </div>
                        <group>
                            <group name="risk" string="Risk Profile">
                                <field name="category"/>
                                <field name="severity"/>
                                <field name="weight"/>
                                <field name="action_type" class="oe_inline"/>
                                <field name="active"/>
                            </group>
                            <group name="logic" string="Evaluation Logic">
                                <field name="rule_type"/>
                                <field name="domain" invisible="rule_type != 'domain'" widget="domain" options="{'model': 'account.move'}"/>
                                <field name="python_code" invisible="rule_type != 'python'" widget="ace" options="{'mode': 'python'}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Diagnostics &amp; Fix" name="diagnostics">
                                <group>
                                    <field name="description" placeholder="Explained diagnostic reason for the auditor..."/>
                                    <field name="suggested_action" placeholder="Step-by-step fix..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_forensic_rules" model="ir.actions.act_window">
            <field name="name">Forensic Rules Engine</field>
            <field name="res_model">forensic.rule</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Define your first Forensic Rule
              </p><p>
                Create dynamic rules to detect fraud or mistakes using Domain or Python logic.
              </p>
            </field>
        </record>



        <!-- Menus -->
        <menuitem id="menu_forensic_config" name="Configuration" parent="menu_forensic_root" sequence="100"/>
        <menuitem id="menu_forensic_rules" name="Rules Engine" parent="menu_forensic_config" action="action_forensic_rules" sequence="10"/>


        <!-- Exclusive Forensic Tree View (No Inheritance conflicts) -->
        <record id="view_move_tree_forensic_exclusive" model="ir.ui.view">
            <field name="name">account.move.tree.forensic.exclusive</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list string="التدقيق الجنائي للفواتير" decoration-danger="risk_level == 'critical'" decoration-warning="risk_level == 'high'" sample="1">
                    <field name="name" decoration-bf="1"/>
                    <field name="risk_score" widget="badge" decoration-danger="risk_score >= 70" decoration-warning="risk_score >= 30" string="🚩"/>
                    <field name="forensic_diagnostic" string="سبب المشكلة" decoration-danger="risk_score >= 70"/>
                    <field name="forensic_resolution" string="الحل المقترح" decoration-info="True"/>
                    <field name="risk_level" widget="badge" decoration-danger="risk_level == 'critical'" decoration-warning="risk_level == 'high'" optional="hide"/>
                    <field name="invoice_partner_display_name" string="الطرف الآخر"/>
                    <field name="invoice_date" string="التاريخ"/>
                    <field name="amount_total_in_currency_signed" string="الإجمالي" sum="Total"/>
                    <field name="audit_status" widget="badge" string="الحالة"/>
                    <field name="state" widget="badge" decoration-success="state == 'posted'"/>
                </list>
            </field>
        </record>

        <!-- Exclusive Forensic Stock Picking List -->
        <record id="view_picking_tree_forensic_exclusive" model="ir.ui.view">
            <field name="name">stock.picking.tree.forensic.exclusive</field>
            <field name="model">stock.picking</field>
            <field name="arch" type="xml">
                <list string="أذون المخازن المشبوهة" decoration-danger="note != False" sample="1">
                    <field name="name" string="رقم الإذن" decoration-bf="1"/>
                    <field name="note" string="🛡️ التنبيه الجنائي" decoration-danger="1"/>
                    <field name="location_id" string="من"/>
                    <field name="location_dest_id" string="إلى"/>
                    <field name="partner_id" string="الجهة"/>
                    <field name="origin" string="المستند الأصلي"/>
                    <field name="state" widget="badge" decoration-success="state == 'done'"/>
                </list>
            </field>
        </record>

        <!-- Exclusive Forensic Sale List -->
        <record id="view_sale_order_tree_forensic_exclusive" model="ir.ui.view">
            <field name="name">sale.order.tree.forensic.exclusive</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <list string="أوامر البيع المشبوهة" decoration-danger="forensic_alert != False" sample="1">
                    <field name="name" string="رقم الأمر" decoration-bf="1"/>
                    <field name="forensic_alert" string="🛡️ التنبيه الجنائي" decoration-danger="1"/>
                    <field name="partner_id" string="العميل"/>
                    <field name="date_order" string="التاريخ"/>
                    <field name="amount_total" string="الإجمالي"/>
                    <field name="state" widget="badge" decoration-success="state == 'sale'"/>
                </list>
            </field>
        </record>

        <!-- ============================================================
             🚨 NEW: Purchase Order RNI (Received Not Invoiced) Views
        ============================================================ -->
        <record id="view_purchase_order_tree_forensic_rni" model="ir.ui.view">
            <field name="name">purchase.order.tree.forensic.rni</field>
            <field name="model">purchase.order</field>
            <field name="arch" type="xml">
                <list string="🚨 أوامر شراء مستلمة لم تُفوتر" 
                      decoration-danger="rni_status == 'missing'" 
                      decoration-warning="rni_status == 'partial'"
                      decoration-success="rni_status == 'ok'"
                      default_order="rni_amount desc">
                    <field name="name" string="رقم أمر الشراء" decoration-bf="1"/>
                    <field name="partner_id" string="المورد"/>
                    <field name="date_approve" string="تاريخ الاعتماد"/>
                    <field name="rni_status" widget="badge" string="حالة الفوترة"
                           decoration-danger="rni_status == 'missing'"
                           decoration-warning="rni_status == 'partial'"
                           decoration-success="rni_status == 'ok'"/>
                    <field name="rni_amount" string="💰 مبلغ بدون فاتورة" sum="إجمالي المبالغ المعلقة"
                           decoration-danger="rni_amount > 0" decoration-bf="rni_amount > 0"/>
                    <field name="forensic_alert" string="🛡️ التنبيه" decoration-danger="1"/>
                    <field name="amount_total" string="إجمالي الأمر" sum="Total"/>
                    <field name="invoice_status" string="حالة الفاتورة" widget="badge"
                           decoration-danger="invoice_status == 'to invoice'"
                           decoration-success="invoice_status == 'invoiced'"/>
                    <field name="state" widget="badge" decoration-success="state == 'purchase'"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Purchase Order RNI Search View -->
        <record id="view_purchase_order_search_forensic_rni" model="ir.ui.view">
            <field name="name">purchase.order.search.forensic.rni</field>
            <field name="model">purchase.order</field>
            <field name="arch" type="xml">
                <search string="فحص المشتريات">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <filter string="🚨 لم يُفوتر نهائياً" name="not_invoiced" domain="[('rni_status', '=', 'missing')]"/>
                    <filter string="⚠️ فوترة جزئية" name="partial" domain="[('rni_status', '=', 'partial')]"/>
                    <filter string="🚩 كل المشبوهة" name="all_rni" domain="[('rni_amount', '>', 0)]"/>
                    <separator/>
                    <filter string="📅 أقدم من 30 يوم" name="old_rni" domain="[('date_approve', '&lt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d')), ('rni_amount', '>', 0)]"/>
                    <separator/>
                    <group expand="0" string="تجميع حسب">
                        <filter string="المورد" name="group_vendor" context="{'group_by': 'partner_id'}"/>
                        <filter string="حالة الفوترة" name="group_rni" context="{'group_by': 'rni_status'}"/>
                        <filter string="الشهر" name="group_month" context="{'group_by': 'date_approve:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Purchase Order RNI Action -->
        <record id="action_purchase_rni_center" model="ir.actions.act_window">
            <field name="name">🚨 مركز المشتريات المعلقة (RNI)</field>
            <field name="res_model">purchase.order</field>
            <field name="view_mode">list,form</field>
            <field name="views">[(ref('view_purchase_order_tree_forensic_rni'), 'list'), (False, 'form')]</field>
            <field name="search_view_id" ref="view_purchase_order_search_forensic_rni"/>
            <field name="domain">[('state', 'in', ('purchase', 'done'))]</field>
            <field name="context">{'search_default_all_rni': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ✅ لا توجد أوامر شراء معلقة!
                </p>
                <p>جميع أوامر الشراء المستلمة تم فوترتها بنجاح.</p>
            </field>
        </record>

        <!-- Menu under Forensic Engine -->
        <menuitem id="menu_forensic_rni_center"
                  name="🚨 مشتريات بدون فواتير (RNI)"
                  parent="menu_forensic_operations_parent"
                  action="action_purchase_rni_center"
                  sequence="3"/>

        <!-- Also add under native Purchase menu -->
        <menuitem id="menu_purchase_rni_reports"
                  name="🛡️ بضاعة مستلمة لم تُفوتر"
                  parent="purchase.menu_procurement_management"
                  action="action_purchase_rni_center"
                  sequence="99"/>

        <!-- Exclusive Forensic MRP List -->
        <record id="view_production_tree_forensic_exclusive" model="ir.ui.view">
            <field name="name">mrp.production.tree.forensic.exclusive</field>
            <field name="model">mrp.production</field>
            <field name="arch" type="xml">
                <list string="أوامر التصنيع المشبوهة" decoration-danger="forensic_alert != False" sample="1">
                    <field name="name" string="رقم الأمر" decoration-bf="1"/>
                    <field name="forensic_alert" string="🛡️ التنبيه الجنائي" decoration-danger="1"/>
                    <field name="product_id" string="المنتج"/>
                    <field name="product_qty" string="الكمية"/>
                    <field name="date_start" string="التاريخ"/>
                    <field name="state" widget="badge" decoration-success="state == 'done'"/>
                </list>
            </field>
        </record>

        <!-- Keep Form Inheritance for details -->






        <!-- Inherit Account Move Form to show Risk details -->

        <record id="view_move_form_forensic_risk_inherit" model="ir.ui.view">
            <field name="name">account.move.form.forensic.risk.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="after">
                    <div class="alert alert-danger mb-0 text-center" role="alert" invisible="risk_level not in ('high', 'critical')">
                        <strong>🛡️ High Risk Entry:</strong> This document has a risk score of <field name="risk_score" class="oe_inline"/>. Follow Audit Procedures.
                    </div>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_run_forensic_scan" type="object" class="oe_stat_button" icon="fa-stethoscope" string="Run Scan"/>
                </xpath>

                <xpath expr="//field[@name='ref']" position="after">
                     <field name="risk_score" widget="gauge" options="{'max_field': 'risk_score'}" style="width: 100px; height: 100px;" invisible="risk_score == 0"/>
                     <field name="risk_level" widget="badge" decoration-danger="risk_level == 'critical'" decoration-warning="risk_level == 'high'"/>
                </xpath>
                <xpath expr="//page[@name='other_info']" position="inside">
                     <group string="Forensic &amp; Audit Trail" name="forensic_audit_trail">
                         <field name="audit_status" widget="badge"/>
                         <field name="late_night_activity"/>
                         <field name="forensic_rule_ids" widget="many2many_tags" options="{'no_create': True}"/>
                     </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
