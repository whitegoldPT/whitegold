<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- New POS security group -->
        <record id="group_pos_create_customer" model="res.groups">
            <field name="name">POS / Create Customer</field>
            <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
            <field name="comment">Users in this group are allowed to create new customers from the Point of Sale interface.</field>
        </record>

        <!-- POS Manager automatically inherits permission to create customers -->
        <record id="point_of_sale.group_pos_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('pos_customer_create_access.group_pos_create_customer'))]"/>
        </record>

    </data>
</odoo>
