<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Dummy record used as container for the Live Tracking dashboard. 
             This is required for the form view to function. -->
        <record id="traccar_live_tracking_dummy" model="traccar.device">
            <field name="name">Fleet Control Center</field>
            <field name="unique_id">DASHBOARD_ONLY</field>
            <field name="status">unknown</field>
            <field name="disabled">True</field>
        </record>
    </data>

    <data>
        <!-- Live Tracking View -->
        <record id="view_traccar_live_tracking" model="ir.ui.view">
            <field name="name">traccar.live.tracking</field>
            <field name="model">traccar.device</field>
            <field name="arch" type="xml">
                <form string="Live GPS Tracking" create="false" edit="false" delete="false">
                    <header>
                        <button name="sync_all_data" type="object"
                                string="Full Sync" class="btn-primary" icon="fa-refresh"/>
                        <button name="open_devices" type="object"
                                string="Device Management" class="btn-secondary" icon="fa-list"/>
                        <div class="ms-auto d-flex align-items-center me-3">
                            <span id="header_status_badge" class="badge rounded-pill bg-info-light text-info border border-info px-3 py-2">
                                <i class="fa fa-circle-o-notch fa-spin me-1 d-none" id="header_status_spinner"></i>
                                <span id="header_status_text">Ready</span>
                            </span>
                        </div>
                    </header>
                    <sheet>
                        <div class="traccar-dashboard-wrapper">
                            <!-- Stats Header -->
                            <div class="traccar-header-stats mb-3">
                                <div class="stat-card">
                                    <div class="stat-icon bg-primary-soft">🚙</div>
                                    <div class="stat-content">
                                        <h4 id="total_devices">0</h4>
                                        <span>Total</span>
                                    </div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-icon bg-success-soft">🔋</div>
                                    <div class="stat-content">
                                        <h4 id="online_devices">0</h4>
                                        <span>Online</span>
                                    </div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-icon bg-danger-soft">📵</div>
                                    <div class="stat-content">
                                        <h4 id="offline_devices">0</h4>
                                        <span>Offline</span>
                                    </div>
                                </div>
                                <div class="stat-card" id="unknown_devices_wrapper">
                                    <div class="stat-icon bg-warning-soft">🛰️</div>
                                    <div class="stat-content">
                                        <h4 id="unknown_devices">0</h4>
                                        <span>Unknown</span>
                                    </div>
                                </div>
                            </div>

                            <div class="traccar-main-layout">
                                <!-- Sidebar -->
                                <div class="traccar-sidebar">
                                    <div class="sidebar-search">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0">
                                                <i class="fa fa-search text-muted"></i>
                                            </span>
                                            <input type="text" id="device_search" class="form-control border-start-0" placeholder="Search devices..."/>
                                        </div>
                                    </div>
                                    <div class="sidebar-list" id="device_list_container">
                                        <div class="text-center p-4 text-muted">
                                            <i class="fa fa-spinner fa-spin mb-2"></i>
                                            <p>Loading devices...</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Map Section -->
                                <div class="traccar-map-section">
                                    <div id="traccar_live_map_container">
                                        <div id="traccar_live_map"></div>
                                        <!-- Map Overlays -->
                                        <div class="map-overlay-controls">
                                            <a name="btn_fit_bounds" id="btn_fit_bounds" class="btn btn-sm btn-light shadow-sm mb-2" title="Fit all devices">
                                                <i class="fa fa-expand"/>
                                            </a>
                                            <br/>
                                            <a name="btn_toggle_fullscreen" id="btn_toggle_fullscreen" icon="fa-arrows-alt" class="btn btn-sm btn-light shadow-sm" title="Expand Map">
                                                <i class="fa fa-arrows-alt"/>
                                            </a>
                                        </div>


                                        <!-- Route Replay Overlay -->
                                        <div id="traccar_replay_overlay" class="traccar-replay-overlay d-none">
                                            <div class="replay-card">
                                                <div class="replay-header">
                                                    <span><i class="fa fa-history"></i> Route Replay</span>
                                                    <a name="btn_close_replay" class="btn-close-replay" style="cursor: pointer; text-decoration: none; color: inherit;">×</a>
                                                </div>
                                                <div class="replay-body">
                                                    <div class="form-group mb-2">
                                                        <span class="o_form_label small fw-bold">From</span>
                                                        <input type="datetime-local" id="replay_from" class="form-control form-control-sm" />
                                                    </div>
                                                    <div class="form-group mb-3">
                                                        <span class="o_form_label small fw-bold">To</span>
                                                        <input type="datetime-local" id="replay_to" class="form-control form-control-sm" />
                                                    </div>
                                                    <a name="btn_confirm_replay" id="btn_confirm_replay" class="btn btn-primary btn-sm w-100 mb-2 text-white">
                                                        <i class="fa fa-play"/> Show Route
                                                    </a>
                                                    <div id="replay_status" class="small text-muted text-center d-none">
                                                        <i class="fa fa-spinner fa-spin"/> Searching...
                                                    </div>

                                                    <!-- Playback Controls -->
                                                    <div id="playback_container" class="mt-3 border-top pt-3 d-none">
                                                        <div class="d-flex justify-content-end mb-1">
                                                            <span id="replay_total_distance" class="fw-bold px-2 py-1 rounded-pill" style="font-size: 11px; background: #f8fafc; border: 1px solid #e2e8f0; color: #1e293b;">0.00 km</span>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-2 mb-2">
                                                            <a id="btn_play_pause" class="btn btn-sm btn-primary text-white" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; padding: 0;">
                                                                <i class="fa fa-play"/>
                                                            </a>
                                                            <input type="range" id="replay_slider" class="form-range flex-grow-1" min="0" value="0" step="1" style="height: 4px;"/>
                                                        </div>
                                                        <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 10px; color: #64748b;">
                                                            <span id="replay_current_time">--:--</span>
                                                            <div class="d-flex gap-2">
                                                                <span id="replay_current_speed" class="fw-bold text-primary">0 km/h</span>
                                                                <select id="playback_speed_mult" class="form-select form-select-sm border-0 bg-transparent p-0" style="width: 40px; font-size: 10px; cursor: pointer;">
                                                                    <option value="1">1x</option>
                                                                    <option value="2">2x</option>
                                                                    <option value="5">5x</option>
                                                                    <option value="10">10x</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Live Tracking Action -->
        <record id="action_traccar_live_tracking" model="ir.actions.act_window">
            <field name="name">Live GPS Tracking</field>
            <field name="res_model">traccar.device</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_traccar_live_tracking"/>
            <field name="target">current</field>
            <!-- Always open the dummy record -->
            <field name="res_id" ref="traccar_live_tracking_dummy"/>
            <field name="context">{'form_view_initial_mode': 'view', 'create': False, 'edit': False}</field>
        </record>

        <!-- Add to menu -->
        <menuitem id="menu_traccar_live_tracking"
                  name="Live Map"
                  parent="menu_traccar_root"
                  action="action_traccar_live_tracking"
                  sequence="5"/>
    </data>
</odoo>
