<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend Fleet Vehicle Form View -->
        <record id="fleet_vehicle_view_form_inherit" model="ir.ui.view">
            <field name="name">fleet.vehicle.form.inherit</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
            <field name="arch" type="xml">

                <!-- Add GPS stat button -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="object"
                            name="open_tracking_data" icon="fa-map-marker"
                            invisible="not traccar_device_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">GPS</span>
                            <span class="o_stat_text">Tracking</span>
                        </div>
                    </button>
                </xpath>

                <!-- Insert GPS Tracking tab after first page -->
                <xpath expr="//page[1]" position="after">
                    <page string="GPS Tracking" name="gps_tracking">
                        <group>
                            <group string="GPS Device">
                                <field name="traccar_device_id"/>
                                <field name="tracking_active" readonly="1"/>
                            </group>
                            <group string="Current Position">
                                <field name="current_location" readonly="1"/>
                                <field name="last_position_time" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
