<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- GPS Tracking User Group -->
        <record id="group_traccar_user" model="res.groups">
            <field name="name">GPS Tracking User</field>
            <field name="category_id" ref="base.group_user"/>
            <field name="comment">Access to GPS tracking data</field>
        </record>

        <!-- GPS Tracking Manager Group -->
        <record id="group_traccar_manager" model="res.groups">
            <field name="name">GPS Tracking Manager</field>
            <field name="category_id" ref="base.group_user"/>
            <field name="implied_ids" eval="[(4, ref('group_traccar_user'))]"/>
            <field name="comment">Full access to GPS tracking system</field>
        </record>

        <!-- Record Rules -->
        <record id="traccar_device_rule_user" model="ir.rule">
            <field name="name">Traccar Device User Access</field>
            <field name="model_id" ref="model_traccar_device"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_traccar_user'))]"/>
        </record>

        <record id="traccar_position_rule_user" model="ir.rule">
            <field name="name">Traccar Position User Access</field>
            <field name="model_id" ref="model_traccar_position"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_traccar_user'))]"/>
        </record>
    </data>
</odoo>
